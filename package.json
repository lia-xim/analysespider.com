{
  "name": "analysespider-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project foundation for a safe, inspectable web diagnostics lab under new ownership.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-cap-assets.mjs && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "qa:a11y": "axe http://127.0.0.1:4321/ http://127.0.0.1:4321/tools http://127.0.0.1:4321/tools/crawler-view http://127.0.0.1:4321/tools/google-index-check http://127.0.0.1:4321/tools/robots-txt-generator http://127.0.0.1:4321/tools/log-file-inspector http://127.0.0.1:4321/tools/bot-verification http://127.0.0.1:4321/de http://127.0.0.1:4321/de/tools/http-antwort http://127.0.0.1:4321/de/tools/crawler-sicht http://127.0.0.1:4321/de/tools/google-index-check http://127.0.0.1:4321/de/tools/robots-txt-generator http://127.0.0.1:4321/de/tools/server-log-analyse http://127.0.0.1:4321/de/tools/bot-verifizierung http://127.0.0.1:4321/de/wissen/robots-erlaubt-cdn-blockiert http://127.0.0.1:4321/de/wissen/initiales-html-vs-gerenderter-dom --exit",
    "qa:browser": "node scripts/browser-smoke.mjs",
    "update:crawler-ranges": "node scripts/update-crawler-ip-ranges.mjs",
    "verify": "pnpm build && pnpm qa"
  },
  "dependencies": {
    "@cap.js/wasm": "0.0.7",
    "@cap.js/widget": "0.1.56",
    "astro": "7.2.1",
    "pako": "2.1.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.13.0",
    "@astrojs/check": "0.9.10",
    "chromedriver": "151.0.5",
    "selenium-webdriver": "4.44.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["chromedriver"],
    "overrides": {
      "chromedriver": "151.0.5"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
