---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolBoundary from "../../components/ToolBoundary.astro";
import ToolNavigator from "../../components/ToolNavigator.astro";
interface Props { locale?: "en" | "de" }
const { locale = "en" } = Astro.props;
const de = locale === "de";
---
<BaseLayout
  title={de ? "Redirect Checker: Weiterleitungskette prüfen — AnalyseSpider" : "Redirect Checker: Trace 301, 302 and Redirect Chains — AnalyseSpider"}
  description={de ? "Prüfe 301, 302, 307, 308, Weiterleitungsketten und Schleifen live oder werte kopierte HTTP-Antworten lokal aus." : "Check 301, 302, 307 and 308 redirects, chains and loops live, or analyse pasted HTTP response blocks locally."}
  canonicalPath={de ? "/de/tools/weiterleitungskette" : "/tools/redirect-chain"}
  alternatePath={de ? "/tools/redirect-chain" : "/de/tools/weiterleitungskette"}
  lang={locale}
  bodyClass="tool-page"
>
  <section class="tool-shell">
    <aside class="tool-sidebar">
      <h1>{de ? "Redirect Checker: URL-Weiterleitung prüfen" : "Redirect Checker"}</h1>
      <p>{de ? "Gib eine Domain oder URL ein und prüfe 301, 302, 307 und 308 sowie Redirect-Ketten oder Schleifen. Bereits kopierte Antworten kannst du lokal in diesem Browser auswerten." : "Enter a domain or URL for a live check. If you already captured the responses, paste those instead and they stay in this browser."}</p>
      <button class="button sidebar-action" id="load-chain-sample" type="button">{de ? "Beispiel mit drei Schritten" : "Load a 3-hop example"}</button>
      <div class="sidebar-meta">
        <strong>What it accepts</strong><br />
        One public domain or URL<br />
        12 response blocks maximum<br />
        64 KB input maximum<br />
        HTTP(S) URLs only<br />
        Protected live fetch or local parsing
      </div>
    </aside>

    <div class="tool-main">
      <ToolBoundary hybrid />
      <ToolNavigator current={de ? "/de/tools/weiterleitungskette" : "/tools/redirect-chain"} locale={locale} />
      <section class="workspace" aria-labelledby="chain-input-heading">
        <div class="workspace-toolbar"><span class="active">Enter a URL or paste captured responses</span><span>The tool chooses the right mode</span></div>
        <div class="workspace-content">
          <h2 id="chain-input-heading" class="visually-hidden">Redirect chain input</h2>
          <div class="tool-question"><strong>{de ? "Starte mit einer URL oder einem Beispiel" : "Start with a URL or an example"}</strong><p>{de ? "Du musst keine HTTP-Header zusammensuchen. Gib eine Domain ein oder nutze ein Beispiel." : "You do not need to collect HTTP headers yourself. Enter a domain for a live check, or use one of these examples to see how the result works."}</p></div>
          <div class="tool-presets" aria-label="Redirect examples">
            <button type="button" data-chain-preset="clean"><strong>{de ? "Keine Weiterleitung" : "No redirect"}</strong><span>{de ? "Die Zielseite antwortet mit 200" : "A final page responds with 200"}</span></button>
            <button type="button" data-chain-preset="single"><strong>{de ? "Eine Weiterleitung" : "One redirect"}</strong><span>{de ? "Ein 301 zeigt auf die Zielseite" : "A normal 301 points to the final page"}</span></button>
            <button type="button" data-chain-preset="broken"><strong>{de ? "Defekte Kette" : "Broken chain"}</strong><span>{de ? "Einer Weiterleitung fehlt das Ziel" : "A redirect is missing its destination"}</span></button>
          </div>
          <label for="chain-input">{de ? "Domain, URL oder kopierte HTTP-Antwortblöcke" : "Domain, URL or captured HTTP response blocks"}</label>
          <textarea id="chain-input" spellcheck="false" placeholder="contextter.com&#10;&#10;or paste:&#10;&#10;URL: https://example.com/old&#10;HTTP/2 301&#10;Location: /new&#10;&#10;URL: https://example.com/new&#10;HTTP/2 200"></textarea>
          <p class="field-help">A single URL uses the same protected crawler gateway as the main check. Pasted blocks are analysed locally; each needs a <code>URL:</code> line and an HTTP status line.</p>
          <div class="workspace-actions">
            <button class="button" id="clear-chain" type="button">{de ? "Leeren" : "Clear"}</button>
            <button class="button primary" id="analyse-chain" type="button">{de ? "Kette prüfen" : "Check redirect chain"}</button>
          </div>
          <p class="form-status" id="chain-status" role="status" aria-live="polite">{de ? "Gib eine URL ein oder füge Antworten ein." : "Enter a URL or paste captured responses."}</p>
        </div>
      </section>

      <section class="result-surface" id="chain-results" hidden aria-labelledby="chain-results-heading">
        <div class="workspace-toolbar"><span class="active">The observed chain</span><span id="chain-outcome"></span></div>
        <h2 id="chain-results-heading" class="visually-hidden">Redirect chain result</h2>
        <div class="result-panel">
          <div class="table-wrap">
            <table>
              <thead><tr><th>{de ? "Schritt" : "Hop"}</th><th>Request URL</th><th>Status</th><th>Location</th><th>{de ? "Aufgelöstes Ziel" : "Resolved destination"}</th></tr></thead>
              <tbody id="chain-rows"></tbody>
            </table>
          </div>
        </div>
        <div class="diagnostic-output">
          <section class="evidence-group"><h3>{de ? "BEFUNDE" : "FINDINGS"}</h3><div><ul id="chain-findings"></ul></div></section>
          <section class="evidence-group"><h3>{de ? "OFFEN" : "UNKNOWN"}</h3><div><ul id="chain-unknowns"></ul></div></section>
        </div>
        <div class="workspace-actions result-panel">
          <button class="button" id="copy-chain-evidence" type="button">{de ? "Evidence-JSON kopieren" : "Copy evidence JSON"}</button>
          <a class="button" href="/tools/crawler-view">Run the main URL check</a>
          <button class="button primary" id="open-final-response" type="button" hidden>Inspect the final HTTP response</button>
        </div>
      </section>
    </div>
  </section>

  <section class="content-grid">
    <div class="prose">
      <h2>{de ? "Eine Kette, mehrere getrennte Fragen" : "One chain, several separate decisions"}</h2>
      <p>{de ? <><strong>Wenn du nur eine URL hast:</strong> Füge sie oben ein. AnalyseSpider folgt höchstens drei öffentlichen HTTP-Weiterleitungen über das geschützte Gateway.</> : <><strong>If you only have a URL:</strong> paste it into the field above. AnalyseSpider follows at most three public HTTP redirects through the protected gateway and builds the response blocks for you.</>}</p>
      <p>{de ? <><strong>Wenn du Header hast:</strong> Füge jeden beobachteten Antwortblock ein. Dieser Modus macht keine Netzwerkanfrage.</> : <><strong>If you already have headers:</strong> paste each observed response block. That mode makes no network request and is useful for private test environments or a response captured with browser developer tools or curl.</>}</p>
      <p>{de ? "Status und Location belegen genau einen beobachteten Schritt. Sie beweisen nicht, dass das Ziel indexierbar, canonical, immer erreichbar oder inhaltlich gleichwertig ist." : "A status and Location field establish an observed hop. They do not establish that the destination is indexable, canonical, live in every request context, or equivalent to the source page."}</p>
      <p><a href={de ? "/de/wissen/redirect-kette-pruefen" : "/guides/redirect-chain-analysis"}>{de ? "Die vollständige Redirect-Diagnose lesen" : "Apply the redirect-chain workflow"}</a></p>
      <h3>What the JSON contains</h3>
      <p>The export contains normalised request URLs, statuses, Location fields, resolved destinations, findings, unknowns, and an analysis timestamp. It excludes the raw pasted block.</p>
    </div>
    <aside class="side-note">
      <h3>Collection example</h3>
      <p><code>curl -sS -D - -o /dev/null https://example.com/old</code></p>
      <p>Repeat against the observed Location target. Avoid <code>-L</code> when you need each intermediate response separately.</p>
    </aside>
  </section>

  <script>
    import { GatewayError, normalizePublicUrl, runCrawlerCheck } from "../../lib/crawler-gateway";
    import { formatLiveRedirectEvidence, MAX_REDIRECT_INPUT_BYTES, parseRedirectChain } from "../../lib/redirect-chain";

    const input = document.querySelector<HTMLTextAreaElement>("#chain-input")!;
    const status = document.querySelector<HTMLElement>("#chain-status")!;
    const results = document.querySelector<HTMLElement>("#chain-results")!;
    const copyButton = document.querySelector<HTMLButtonElement>("#copy-chain-evidence")!;
    const responseButton = document.querySelector<HTMLButtonElement>("#open-final-response")!;
    const analyseButton = document.querySelector<HTMLButtonElement>("#analyse-chain")!;
    let latestEvidence: Record<string, unknown> | null = null;
    let latestFinalUrl: string | null = null;
    const sample = `URL: https://example.com/legacy?ref=a
HTTP/2 301
Location: /moved?ref=a
Cache-Control: public, max-age=300

URL: https://example.com/moved?ref=a
HTTP/2 308
Location: https://www.example.com/final?ref=a

URL: https://www.example.com/final?ref=a
HTTP/2 200
X-Robots-Tag: index, follow`;
    const presets = {
      clean: `URL: https://example.com/page
HTTP/2 200
X-Robots-Tag: index, follow`,
      single: `URL: https://example.com/old
HTTP/2 301
Location: /new

URL: https://example.com/new
HTTP/2 200`,
      broken: `URL: https://example.com/old
HTTP/2 302`,
    } as const;

    const fillList = (selector: string, values: string[]) => {
      const list = document.querySelector<HTMLUListElement>(selector)!;
      list.replaceChildren();
      values.forEach((value) => {
        const item = document.createElement("li");
        item.textContent = value;
        list.append(item);
      });
    };

    const renderChain = (raw: string, boundary: string, completion: string) => {
      if (new Blob([raw]).size > MAX_REDIRECT_INPUT_BYTES) {
        results.hidden = true;
        status.textContent = "Input rejected: the 64 KB local limit was exceeded.";
        return false;
      }
      const result = parseRedirectChain(raw);
      if (!result.hops.length) {
        results.hidden = true;
        status.textContent = "These pasted responses are incomplete. Each block needs a URL: line and an HTTP status line such as HTTP/2 301.";
        return false;
      }

      const rows = document.querySelector<HTMLTableSectionElement>("#chain-rows")!;
      rows.replaceChildren();
      result.hops.forEach((hop, index) => {
        const row = document.createElement("tr");
        [String(index + 1), hop.requestUrl, String(hop.status), hop.location ?? "—", hop.resolvedLocation ?? "—"].forEach((value) => {
          const cell = document.createElement("td");
          cell.textContent = value;
          row.append(cell);
        });
        rows.append(row);
      });

      fillList("#chain-findings", result.findings.length ? result.findings : ["No chain inconsistency was detected in the pasted blocks."]);
      fillList("#chain-unknowns", result.unknowns);
      const observedAt = new Date().toISOString();
      latestEvidence = { schemaVersion: 1, tool: "AnalyseSpider Redirect Chain Builder", observedAt, boundary, ...result };
      latestFinalUrl = result.hops.at(-1)?.requestUrl ?? null;
      responseButton.hidden = !latestFinalUrl;
      document.querySelector("#chain-outcome")!.textContent = `${result.outcome.toUpperCase()} · ${result.hops.length} HOPS`;
      results.hidden = false;
      status.textContent = `${completion} ${result.hops.length} observed response${result.hops.length === 1 ? "" : "s"}${result.rejectedBlocks ? `; ${result.rejectedBlocks} invalid block${result.rejectedBlocks === 1 ? "" : "s"} skipped` : ""}.`;
      requestAnimationFrame(() => results.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "start",
      }));
      return true;
    };

    const liveError = (error: unknown) => {
      if (!(error instanceof GatewayError)) return "The live check is temporarily unavailable. Please try again later.";
      if (error.code === "VALIDATION_INVALID_INPUT") return "Enter a public domain or HTTP(S) URL, for example contextter.com.";
      if (error.code.includes("RATE") || error.code.includes("LIMIT")) return "The live-check limit has been reached. Try again after the displayed waiting period.";
      return "The protected live check could not be completed. You can still paste captured response blocks and analyse them locally.";
    };

    const analyse = async () => {
      const raw = input.value.trim();
      if (!raw) {
        results.hidden = true;
        status.textContent = "Enter a domain or URL, or paste at least one captured response block.";
        return;
      }
      const hasResponseSyntax = /^URL\s*:/im.test(raw) || /^HTTP\//im.test(raw);
      if (hasResponseSyntax || raw.includes("\n")) {
        renderChain(raw, "pasted evidence; no network request", "Analysed locally:");
        return;
      }

      analyseButton.disabled = true;
      results.hidden = true;
      status.textContent = "Fetching the public URL and following its redirects safely …";
      try {
        const normalized = normalizePublicUrl(raw);
        input.value = normalized;
        const report = await runCrawlerCheck(normalized);
        const evidence = formatLiveRedirectEvidence(report.fetchFacts);
        input.value = evidence;
        renderChain(
          evidence,
          "protected live fetch via tools.contextter.com",
          report.fetchFacts.cacheState === "hit"
            ? "Cached result loaded (maximum age: one hour):"
            : report.fetchFacts.redirectChain.length
              ? "Fresh live check complete:"
              : "Fresh check complete; no redirect was observed:",
        );
      } catch (error) {
        status.textContent = liveError(error);
      } finally {
        analyseButton.disabled = false;
      }
    };

    document.querySelector("#load-chain-sample")!.addEventListener("click", () => {
      input.value = sample;
      status.textContent = "Sample chain loaded locally.";
      input.focus();
    });
    document.querySelector("#clear-chain")!.addEventListener("click", () => {
      input.value = "";
      latestEvidence = null;
      latestFinalUrl = null;
      responseButton.hidden = true;
      results.hidden = true;
      status.textContent = "Local input and result cleared.";
      input.focus();
    });
    analyseButton.addEventListener("click", analyse);
    document.querySelectorAll<HTMLButtonElement>("[data-chain-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        const preset = presets[button.dataset.chainPreset as keyof typeof presets];
        if (!preset) return;
        input.value = preset;
        renderChain(preset, "example evidence; no network request", "Example explained locally:");
      });
    });
    responseButton.addEventListener("click", () => {
      if (!latestFinalUrl) return;
      sessionStorage.setItem("analysespider.response-url", latestFinalUrl);
      window.location.assign("/tools/url-inspector?from=redirect-chain");
    });
    copyButton.addEventListener("click", async () => {
      if (!latestEvidence) return;
      try {
        await navigator.clipboard.writeText(JSON.stringify(latestEvidence, null, 2));
        status.textContent = "Structured chain evidence copied to the clipboard.";
      } catch {
        status.textContent = "Clipboard access was unavailable. Select and copy from your browser developer tools instead.";
      }
    });

    const transferred = sessionStorage.getItem("analysespider.redirect-chain");
    if (transferred && new URLSearchParams(window.location.search).get("from") === "crawler-check") {
      sessionStorage.removeItem("analysespider.redirect-chain");
      input.value = transferred;
      renderChain(transferred, "transferred from the protected crawler check", "Transferred from the URL check:");
    }
  </script>
</BaseLayout>
