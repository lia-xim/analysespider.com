---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
const tools = [
  { title: "Check server logs", text: "Paste a small Apache or Nginx sample. Find paths, status codes and claimed bots.", href: "/tools/log-file-inspector", note: "Runs in your browser · no upload" },
  { title: "Understand an HTTP response", text: "Paste headers and HTML. Check status, canonical, robots directives and missing fields.", href: "/tools/url-inspector", note: "Paste-only · no fetch" },
  { title: "Check a redirect chain", text: "Build redirect hops and find loops, gaps or an unexpected final URL.", href: "/tools/redirect-chain", note: "Up to 12 hops" },
  { title: "Test a robots.txt rule", text: "Check whether one URL is allowed or blocked for a specific crawler.", href: "/tools/robots-rule-tester", note: "Browser-local test" },
  { title: "Classify an IP address", text: "Recognise public, private and reserved ranges without claiming a person or precise place.", href: "/tools/ip-location", note: "No location database" },
];
---
<BaseLayout
  title="Free crawling and technical SEO tools — AnalyseSpider"
  description="Five free browser-local tools for server logs, HTTP responses, redirect chains, robots.txt and IP addresses."
  canonicalPath="/tools"
  alternatePath="/de/tools"
  bodyClass="simple-content"
>
  <header class="simple-page-lead">
    <h1>Free tools for specific technical questions.</h1>
    <p>Choose the smallest tool that fits the data you already have. The current tools run in your browser and do not send your input to AnalyseSpider.</p>
  </header>
  <section class="plain-resource-list" aria-label="Tools">
    {tools.map((tool) => (
      <a href={tool.href}>
        <div><h2>{tool.title}</h2><p>{tool.text}</p></div>
        <span><small>{tool.note}</small><ArrowIcon /></span>
      </a>
    ))}
  </section>
</BaseLayout>
