---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolBoundary from "../../components/ToolBoundary.astro";
import ToolNavigator from "../../components/ToolNavigator.astro";
interface Props { locale?: "en" | "de" }
const { locale = "en" } = Astro.props;
const de = locale === "de";
const crawlerGroups = [
  {
    label: de ? "Suche" : "Search",
    options: [
      ["googlebot", "Googlebot", "Google Search", true],
      ["oai_searchbot", "OAI-SearchBot", "ChatGPT Search", true],
      ["claude_searchbot", "Claude-SearchBot", "Claude Search", true],
      ["perplexitybot", "PerplexityBot", "Perplexity Search", true],
      ["bingbot", "Bingbot", "Bing Search · local rule test", false],
    ],
  },
  {
    label: de ? "Training und Produktsteuerung" : "Training and product controls",
    options: [
      ["gptbot", "GPTBot", "OpenAI model development", true],
      ["claudebot", "ClaudeBot", "Claude model development", true],
      ["google_extended", "Google-Extended", "Gemini and Vertex AI controls", true],
    ],
  },
  {
    label: de ? "Abruf durch einen Nutzer" : "User-triggered fetch",
    options: [
      ["chatgpt_user", "ChatGPT-User", "ChatGPT user request", true],
      ["claude_user", "Claude-User", "Claude user request", true],
      ["perplexity_user", "Perplexity-User", "Perplexity user request", true],
    ],
  },
] as const;
---
<BaseLayout
  title={de ? "robots.txt-Regel testen — AnalyseSpider" : "Robots.txt Rule Tester — AnalyseSpider"}
  description={de ? "Prüfe eine öffentliche URL für Google-, ChatGPT- oder Claude-Crawler oder teste kopierte robots.txt-Regeln lokal." : "Check a public URL for Google, ChatGPT or Claude crawler access, or test pasted robots.txt rules locally."}
  canonicalPath={de ? "/de/tools/robots-regel-test" : "/tools/robots-rule-tester"}
  alternatePath={de ? "/tools/robots-rule-tester" : "/de/tools/robots-regel-test"}
  lang={locale}
  bodyClass="tool-page"
>
  <section class="tool-shell">
    <aside class="tool-sidebar">
      <h1>{de ? "robots.txt-Regel testen" : "Robots.txt Rule Tester"}</h1>
      <p>{de ? "Wähle Google, ChatGPT oder Claude und gib deine Domain ein. Für genaue Einzelfälle kannst du robots.txt-Regeln auch direkt einfügen." : "Choose Google, ChatGPT or Claude and enter your domain. AnalyseSpider checks the public page. Pasting robots.txt rules remains available for advanced tests."}</p>
      <button class="button sidebar-action" id="load-robots-sample" type="button">{de ? "Beispiel laden" : "Try the example"}</button>
      <div class="sidebar-meta">
        <strong>How the decision works</strong><br />
        RFC 9309 groups<br />
        Exact product token<br />
        Longest path match<br />
        Allow wins equal tie
      </div>
    </aside>

    <div class="tool-main">
      <ToolBoundary hybrid />
      <ToolNavigator current={de ? "/de/tools/robots-regel-test" : "/tools/robots-rule-tester"} locale={locale} />
      <section class="workspace" aria-labelledby="robots-input-heading">
        <div class="workspace-toolbar"><span class="active">Choose a crawler and a page</span><span>Advanced rule test below</span></div>
        <div class="workspace-content">
          <h2 id="robots-input-heading" class="visually-hidden">Robots rule input</h2>
          <div class="tool-question"><strong>{de ? "Welchen Crawler möchtest du prüfen?" : "Which crawler do you want to check?"}</strong><p>{de ? "Wähle zuerst die Aufgabe. Der passende robots.txt-Token wird automatisch übernommen." : "Choose the job first. The matching robots.txt token is filled in automatically."}</p></div>
          <div class="tool-crawler-picker">
            <label for="crawler-select">{de ? "Crawler und Aufgabe" : "Crawler and job"}</label>
            <select id="crawler-select" aria-describedby="crawler-selection-help">
              {crawlerGroups.map((group) => (
                <optgroup label={group.label}>
                  {group.options.map(([id, token, label, liveSupported]) => (
                    <option value={id} data-token={token} data-live-supported={String(liveSupported)} selected={id === "oai_searchbot"}>{label} — {token}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="field-help" id="crawler-selection-help">{de ? "OAI-SearchBot betrifft ChatGPT Search. GPTBot betrifft mögliches Modelltraining." : "OAI-SearchBot controls ChatGPT Search access. GPTBot controls possible model-development access."}</p>
          </div>
          <div class="tool-live-row">
            <div><label for="robots-live-url">{de ? "Öffentliche Domain oder URL" : "Public domain or URL"}</label><input id="robots-live-url" type="text" inputmode="url" autocomplete="url" placeholder="contextter.com" /></div>
            <button class="button primary" id="check-live-robots" type="button">{de ? "Seite live prüfen" : "Check this page live"}</button>
          </div>
          <p class="field-help">The live check uses the protected crawler gateway and the selected crawler token. It does not guarantee indexing or a future visit.</p>
          <div class="tool-advanced-heading"><strong>Advanced: test rules you already have</strong><span>Paste robots.txt below to reproduce one path decision locally.</span></div>
          <div class="input-grid">
            <div>
              <label for="robots-input">{de ? "Inhalt der robots.txt" : "robots.txt content"}</label>
              <textarea id="robots-input" spellcheck="false" placeholder="User-agent: *&#10;Disallow: /private/&#10;Allow: /private/preview/"></textarea>
              <p class="field-help">Input is capped at 500 KiB and stays in this browser tab.</p>
            </div>
            <div class="or-divider" aria-hidden="true">+</div>
            <div>
              <label for="product-token">{de ? "Crawler-Produkt-Token" : "Crawler product token"}</label>
              <input id="product-token" value="OAI-SearchBot" autocomplete="off" spellcheck="false" />
              <label for="target-url">{de ? "Zu prüfende URL oder Pfad" : "URL or path to test"}</label>
              <input id="target-url" value="/private/preview/report" autocomplete="off" spellcheck="false" />
              <p class="field-help">Use the product token from the robots.txt user-agent line, not a full browser user-agent string.</p>
            </div>
          </div>
          <div class="workspace-actions">
            <button class="button" id="clear-robots" type="button">{de ? "Leeren" : "Clear"}</button>
            <button class="button primary" id="test-robots" type="button">{de ? "Regel lokal testen" : "Test rule locally"}</button>
          </div>
          <p class="form-status" id="robots-status" role="status" aria-live="polite">Waiting for a robots.txt rule set.</p>
        </div>
      </section>

      <section class="result-surface" id="robots-results" hidden aria-labelledby="robots-result-heading">
        <div class="workspace-toolbar"><span class="active">Why this rule wins</span><span id="robots-observation-time"></span></div>
        <h2 id="robots-result-heading" class="visually-hidden">Robots rule decision</h2>
        <div class="diagnostic-output">
          <section class="evidence-group">
            <h3>{de ? "ENTSCHEIDUNG" : "DECISION"}</h3>
            <div><p id="robots-decision"></p><p id="robots-reason"></p></div>
          </section>
          <section class="evidence-group">
            <h3>{de ? "PASSENDE REGELN" : "MATCHED EVIDENCE"}</h3>
            <div><ul id="robots-evidence"></ul></div>
          </section>
          <section class="evidence-group">
            <h3>{de ? "GRENZEN" : "BOUNDARIES"}</h3>
            <div><ul id="robots-boundaries"></ul></div>
          </section>
        </div>
      </section>
    </div>
  </section>

  <section class="content-grid">
    <div class="prose">
      <h2>{de ? "Welches Preset passt?" : "Which preset should I choose?"}</h2>
      <p>{de ? "Wähle OAI-SearchBot für die mögliche Aufnahme in die ChatGPT-Suche. GPTBot betrifft mögliches Modelltraining. Claude veröffentlicht ebenfalls getrennte Tokens. Für Google Search und dessen AI-Funktionen bleibt Googlebot relevant." : <>Choose <strong>ChatGPT search</strong> when you care about possible inclusion in ChatGPT search. GPTBot is a separate decision about model training. Claude publishes a separate search token as well. Googlebot remains the relevant crawler for Google Search and its AI search features.</>}</p>
      <h2>{de ? "Was das Ergebnis belegt" : "What this result establishes"}</h2>
      <p>{de ? "Die Live-Prüfung liest die für die öffentliche Seite zurückgegebene Crawler-Entscheidung. Der lokale Test wendet Gruppenauswahl und Pfad-Matching nach RFC 9309 auf deine eingefügten Regeln an." : "The live check reads the crawler decision returned for the public page. The advanced local test applies RFC 9309 group selection and path matching to the exact rules, token and target you pasted. It combines repeated exact-token groups, falls back to the wildcard group only when no exact group exists, and chooses the most specific matching path rule."}</p>
      <p><a href={de ? "/de/wissen/robots-txt-testen" : "/guides/test-robots-txt-rules"}>{de ? "Den vollständigen robots.txt-Leitfaden lesen" : "Follow the complete robots.txt testing workflow"}</a></p>
      <p>The local mode does not fetch <code>/robots.txt</code> or verify its HTTP status and content type. Neither mode models undocumented vendor behaviour or proves that a crawler will obey the file. Robots rules are crawl controls, not authentication and not a reliable way to keep a URL out of search results.</p>
      <p><a href="/guides/test-robots-txt-rules">Follow the complete robots.txt testing workflow</a> or inspect the <a href="/lab/crawler-benchmarks">versioned fixture evidence</a>.</p>
    </div>
    <aside class="side-note">
      <h3>Primary references</h3>
      <p><a href="https://www.rfc-editor.org/rfc/rfc9309.html" rel="noreferrer">RFC 9309</a> defines groups, matching, special characters, access results, and limits.</p>
      <p><a href="https://developers.google.com/search/docs/crawling-indexing/robots/intro" rel="noreferrer">Google Search Central</a> explains why robots.txt is not an indexing or security control.</p>
    </aside>
  </section>

  <script>
    import { GatewayError, normalizePublicUrl, runCrawlerCheck } from "../../lib/crawler-gateway";
    import { evaluateRobots } from "../../lib/robots";
    const source = document.querySelector<HTMLTextAreaElement>("#robots-input")!;
    const token = document.querySelector<HTMLInputElement>("#product-token")!;
    const target = document.querySelector<HTMLInputElement>("#target-url")!;
    const status = document.querySelector<HTMLElement>("#robots-status")!;
    const results = document.querySelector<HTMLElement>("#robots-results")!;
    const liveUrl = document.querySelector<HTMLInputElement>("#robots-live-url")!;
    const liveButton = document.querySelector<HTMLButtonElement>("#check-live-robots")!;
    const crawlerSelect = document.querySelector<HTMLSelectElement>("#crawler-select")!;
    const crawlerHelp = document.querySelector<HTMLElement>("#crawler-selection-help")!;
    const sample = `User-agent: *
Disallow: /private/

User-agent: OAI-SearchBot
Disallow: /private/
Allow: /private/preview/`;

    const selectedCrawlerOption = () => crawlerSelect.selectedOptions[0];
    const syncCrawlerSelection = (announce = true) => {
      const option = selectedCrawlerOption();
      const selectedToken = option?.dataset.token ?? "";
      const liveSupported = option?.dataset.liveSupported !== "false";
      token.value = selectedToken;
      liveButton.disabled = !liveSupported;
      crawlerHelp.textContent = liveSupported
        ? `${option?.textContent?.trim() ?? selectedToken}. The same token is used for the live and local rule checks.`
        : `${option?.textContent?.trim() ?? selectedToken}. This crawler is available for the local pasted-rule test; the protected live matrix does not return it yet.`;
      if (announce) {
        status.textContent = liveSupported
          ? `${selectedToken} selected. Enter a public URL or paste robots.txt below.`
          : `${selectedToken} selected for a local pasted-rule test.`;
      }
    };

    const requestedCrawler = new URLSearchParams(window.location.search).get("crawler")?.trim();
    if (requestedCrawler && /^[A-Za-z0-9_-]+$/.test(requestedCrawler)) {
      const requestedOption = Array.from(crawlerSelect.options).find((option) =>
        option.value.toLowerCase() === requestedCrawler.toLowerCase() ||
        option.dataset.token?.toLowerCase() === requestedCrawler.toLowerCase(),
      );
      if (requestedOption) crawlerSelect.value = requestedOption.value;
      syncCrawlerSelection(false);
      const selectedOption = selectedCrawlerOption();
      status.textContent = selectedOption?.dataset.liveSupported === "false"
        ? `${selectedOption.dataset.token ?? requestedCrawler} selected from the crawler reference for a local pasted-rule test.`
        : `${selectedOption?.dataset.token ?? requestedCrawler} selected from the crawler reference. Enter a public URL or paste robots.txt below.`;
    } else {
      syncCrawlerSelection(false);
    }

    const setList = (selector: string, items: string[]) => {
      const list = document.querySelector<HTMLUListElement>(selector)!;
      list.replaceChildren(...items.map((item) => {
        const entry = document.createElement("li");
        entry.textContent = item;
        return entry;
      }));
    };

    const renderLiveDecision = async () => {
      liveButton.disabled = true;
      results.hidden = true;
      status.textContent = `Checking ${token.value || "the selected crawler"} against the public page …`;
      try {
        const normalized = normalizePublicUrl(liveUrl.value);
        liveUrl.value = normalized;
        const report = await runCrawlerCheck(normalized);
        const selected = report.crawlerMatrix.find((crawler) => crawler.crawlerId === crawlerSelect.value);
        const state = selected?.state ?? "unknown";
        document.querySelector("#robots-decision")!.textContent = state === "blocked" ? "DISALLOWED" : state === "allowed" || state === "no_rule" ? "ALLOWED" : "UNKNOWN";
        document.querySelector("#robots-reason")!.textContent = selected
          ? `${selected.crawlerName}: ${state === "no_rule" ? "no specific blocking rule was observed" : `crawler access is ${state}`}.`
          : "The selected crawler was not present in the live crawler matrix.";
        setList("#robots-evidence", [
          `Checked page: ${report.fetchFacts.finalUrl}`,
          `Page response: ${report.fetchFacts.status ?? "unknown"}`,
          `Crawler token: ${token.value}`,
          `Observed robots state: ${state}`,
        ]);
        setList("#robots-boundaries", [
          "This was one protected live fetch, not a request made by the named crawler.",
          "An allowance does not prove that the crawler will visit, index or cite the page.",
          "Firewall behavior can differ by IP, user-agent and time.",
        ]);
        document.querySelector("#robots-observation-time")!.textContent = `CHECKED ${new Date().toISOString()}`;
        results.hidden = false;
        status.textContent = `${report.fetchFacts.cacheState === "hit" ? "Cached result loaded" : "Fresh live check complete"}: ${state}. Successful results are reused for no more than one hour.`;
        requestAnimationFrame(() => results.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" }));
      } catch (error) {
        status.textContent = error instanceof GatewayError && error.code === "VALIDATION_INVALID_INPUT"
          ? "Enter a public domain or HTTP(S) URL, for example contextter.com."
          : "The protected live check could not be completed. You can still test pasted robots.txt rules locally.";
      } finally {
        liveButton.disabled = selectedCrawlerOption()?.dataset.liveSupported === "false";
      }
    };

    const test = () => {
      try {
        const decision = evaluateRobots(source.value, token.value, target.value);
        document.querySelector("#robots-decision")!.textContent = decision.allowed ? "ALLOWED" : "DISALLOWED";
        document.querySelector("#robots-reason")!.textContent = decision.reason;
        setList("#robots-evidence", [
          `Target compared: ${decision.target}`,
          `Applicable agents: ${decision.matchedAgents.join(", ") || "none"}`,
          decision.selectedRule ? `Selected rule: ${decision.selectedRule.type}: ${decision.selectedRule.pattern}` : "Selected rule: none",
          `${decision.matchedRules.length} rule(s) in the applicable group set.`,
        ]);
        setList("#robots-boundaries", [
          "No robots.txt URL or crawler was contacted.",
          "HTTP status, redirects, encoding headers, caching, and vendor-specific extensions remain unverified.",
          ...(decision.warnings.length ? decision.warnings : ["No parser warnings for this input."]),
        ]);
        document.querySelector("#robots-observation-time")!.textContent = `TESTED ${new Date().toISOString()}`;
        results.hidden = false;
        status.textContent = `Local rule decision: ${decision.allowed ? "allowed" : "disallowed"}.`;
        requestAnimationFrame(() => results.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" }));
      } catch (error) {
        results.hidden = true;
        status.textContent = error instanceof Error ? error.message : "The input could not be evaluated.";
      }
    };

    document.querySelector("#load-robots-sample")!.addEventListener("click", () => {
      source.value = sample;
      crawlerSelect.value = "oai_searchbot";
      syncCrawlerSelection(false);
      target.value = "/private/preview/report";
      status.textContent = "Sample rules loaded locally.";
      source.focus();
    });
    document.querySelector("#clear-robots")!.addEventListener("click", () => {
      source.value = "";
      crawlerSelect.value = "oai_searchbot";
      syncCrawlerSelection(false);
      target.value = "/";
      results.hidden = true;
      status.textContent = "Local input cleared.";
      source.focus();
    });
    document.querySelector("#test-robots")!.addEventListener("click", test);
    liveButton.addEventListener("click", renderLiveDecision);
    crawlerSelect.addEventListener("change", () => syncCrawlerSelection());
  </script>
</BaseLayout>
