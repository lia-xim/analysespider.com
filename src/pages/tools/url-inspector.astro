---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolBoundary from "../../components/ToolBoundary.astro";
import ToolNavigator from "../../components/ToolNavigator.astro";
interface Props { locale?: "en" | "de" }
const { locale = "en" } = Astro.props;
const de = locale === "de";
---
<BaseLayout
  title={de ? "HTTP-Antwort verstehen — AnalyseSpider" : "HTTP Response Inspector — AnalyseSpider"}
  description={de ? "Prüfe eine öffentliche URL geschützt live oder werte kopierte Header und HTML lokal im Browser aus." : "Enter a public URL for a protected live response check, or inspect pasted headers and HTML locally."}
  canonicalPath={de ? "/de/tools/http-antwort" : "/tools/url-inspector"}
  alternatePath={de ? "/tools/url-inspector" : "/de/tools/http-antwort"}
  lang={locale}
  bodyClass="tool-page"
>
  <section class="tool-shell">
    <aside class="tool-sidebar">
      <h1>{de ? "HTTP-Antwort verstehen" : "Read an HTTP Response"}</h1>
      <p>{de ? "Gib eine öffentliche URL ein. AnalyseSpider liest Status, Weiterleitung, Robots-Angaben und Canonical. Kopierte Header oder HTML kannst du stattdessen lokal prüfen." : "Enter a public URL and AnalyseSpider collects the useful response signals. If you already copied headers or HTML, you can inspect those locally instead."}</p>
      <button class="button sidebar-action" id="load-response-sample" type="button">{de ? "Beispiel laden" : "Try the example"}</button>
      <div class="sidebar-meta">
        <strong>Where to copy it from</strong><br />
        Browser network panel<br />
        <code>curl -I</code> output<br />
        Raw HTTP response<br />
        Page-source excerpt
      </div>
    </aside>

    <div class="tool-main">
      <ToolBoundary hybrid />
      <ToolNavigator current={de ? "/de/tools/http-antwort" : "/tools/url-inspector"} locale={locale} />
      <section class="workspace" aria-labelledby="response-input-heading">
        <div class="workspace-toolbar"><span class="active">Enter a URL or paste the response</span><span>The tool chooses the right mode</span></div>
        <div class="workspace-content">
          <h2 id="response-input-heading" class="visually-hidden">Response input</h2>
          <div class="tool-question"><strong>{de ? "Was möchtest du prüfen?" : "What do you want to check?"}</strong><p>{de ? "Teste zuerst ein Beispiel oder gib im ersten Feld eine Domain für die Live-Prüfung ein." : "Try a typical response first, or put a domain in the first field for a live check."}</p></div>
          <div class="tool-presets" aria-label="HTTP response examples">
            <button type="button" data-response-preset="healthy"><strong>{de ? "Erreichbare Seite" : "Healthy page"}</strong><span>{de ? "200 mit indexierbarem Canonical" : "200 response with an indexable canonical"}</span></button>
            <button type="button" data-response-preset="redirect"><strong>{de ? "Weiterleitung" : "Redirect"}</strong><span>{de ? "301 zeigt auf eine neue URL" : "301 response pointing to a new URL"}</span></button>
            <button type="button" data-response-preset="noindex"><strong>{de ? "Indexierung blockiert" : "Blocked indexing"}</strong><span>{de ? "200-Antwort mit noindex" : "200 response carrying noindex"}</span></button>
          </div>
          <div class="input-grid">
            <div>
              <label for="header-input">{de ? "Domain, URL oder Antwort-Header" : "Domain, URL or response headers"}</label>
              <textarea id="header-input" spellcheck="false" placeholder="contextter.com&#10;&#10;or paste:&#10;HTTP/2 301&#10;location: https://example.com/new-path"></textarea>
              <p class="field-help">{de ? "Eine einzelne URL nutzt den geschützten Live-Abruf. Ein Block ab HTTP/ bleibt in diesem Browser." : "A single URL uses the protected live fetch. A block beginning with HTTP/ stays in this browser."}</p>
            </div>
            <div class="or-divider" aria-hidden="true">+</div>
            <div>
              <label for="html-input">{de ? "HTML-Quelltext oder Head-Ausschnitt (optional)" : "HTML source or head excerpt (optional)"}</label>
              <textarea id="html-input" spellcheck="false" placeholder='<link rel="canonical" href="https://example.com/new-path">&#10;<meta name="robots" content="index,follow">'></textarea>
            </div>
          </div>
          <div class="workspace-actions">
            <button class="button" id="clear-response" type="button">{de ? "Leeren" : "Clear"}</button>
            <button class="button primary" id="inspect-response" type="button">{de ? "Antwort prüfen" : "Inspect response"}</button>
          </div>
          <p class="form-status" id="response-status" role="status" aria-live="polite">{de ? "Warte auf eine URL oder kopierte Antwort." : "Waiting for pasted evidence."}</p>
        </div>
      </section>

      <section class="result-surface" id="response-results" hidden aria-labelledby="response-result-heading">
        <div class="workspace-toolbar"><span class="active">What it tells you</span><span id="observation-time"></span></div>
        <h2 id="response-result-heading" class="visually-hidden">Response inspection result</h2>
        <div class="diagnostic-output">
          <section class="evidence-group">
            <h3>{de ? "BEOBACHTET" : "OBSERVED"}</h3>
            <div><ul id="observed-list"></ul></div>
          </section>
          <section class="evidence-group">
            <h3>{de ? "ABGELEITET" : "INFERRED"}</h3>
            <div><ul id="inferred-list"></ul></div>
          </section>
          <section class="evidence-group">
            <h3>{de ? "OFFEN" : "UNKNOWN"}</h3>
            <div><ul id="unknown-list"></ul></div>
          </section>
        </div>
      </section>
    </div>
  </section>

  <section class="content-grid">
    <div class="prose">
      <h2>{de ? "Woher kommen diese Header?" : "Where do these headers come from?"}</h2>
      <p>{de ? "Wenn du nur eine Domain hast, gib sie oben ein. AnalyseSpider ruft genau eine öffentliche Seite über das geschützte Gateway ab und erklärt Status, Content-Type, Robots-Angaben und Canonical." : "If you only have a domain, enter it above. AnalyseSpider fetches one public page through the protected gateway and turns the observed status, content type, robots directives and canonical into readable evidence."}</p>
      <p>{de ? <>Für eine private Testumgebung öffnest du im Browser die Netzwerkansicht oder nutzt <code>curl -I https://example.com/</code>. Eingefügte Header werden ohne Netzwerkanfrage ausgewertet.</> : <>For a response from a private test environment, open the Network panel in your browser developer tools and reload the page, or run <code>curl -I https://example.com/</code>. Paste those headers here; that mode makes no network request.</>}</p>
      <p><a href={de ? "/de/wissen/http-antwort-verstehen" : "/guides/http-response-debugging"}>{de ? "HTTP-Antwort Schritt für Schritt verstehen" : "Read the response debugging guide"}</a></p>
    </div>
    <aside class="side-note">
      <h3>Useful collection commands</h3>
      <p><code>curl -I https://example.com/</code></p>
      <p>For each redirect hop, preserve the status, <code>Location</code>, robots headers, and observation time.</p>
    </aside>
  </section>

  <script>
    import { GatewayError, normalizePublicUrl, runCrawlerCheck } from "../../lib/crawler-gateway";
    const headerInput = document.querySelector<HTMLTextAreaElement>("#header-input")!;
    const htmlInput = document.querySelector<HTMLTextAreaElement>("#html-input")!;
    const status = document.querySelector<HTMLElement>("#response-status")!;
    const results = document.querySelector<HTMLElement>("#response-results")!;
    const inspectButton = document.querySelector<HTMLButtonElement>("#inspect-response")!;
    const sampleHeaders = `HTTP/2 301
date: Fri, 22 Aug 2026 09:00:00 GMT
location: https://example.com/new-path
x-robots-tag: noindex, follow
cache-control: public, max-age=300
content-type: text/html; charset=utf-8`;
    const sampleHtml = `<!doctype html>
<html><head>
  <link rel="canonical" href="https://example.com/new-path">
  <meta name="robots" content="index, follow">
  <title>Moved page</title>
</head><body></body></html>`;
    const presets = {
      healthy: { headers: "HTTP/2 200\ncontent-type: text/html; charset=utf-8", html: '<link rel="canonical" href="https://example.com/page">\n<meta name="robots" content="index, follow">' },
      redirect: { headers: sampleHeaders, html: sampleHtml },
      noindex: { headers: "HTTP/2 200\ncontent-type: text/html; charset=utf-8\nx-robots-tag: noindex, follow", html: '<link rel="canonical" href="https://example.com/private">\n<meta name="robots" content="noindex, follow">' },
    } as const;

    type TransferredResponse = {
      status: number | null;
      contentType: string | null;
      xRobotsTag: readonly string[];
      canonical: string | null;
      metaRobots: readonly string[];
    };

    const loadResponse = (response: TransferredResponse) => {
      if (response.status === null) return false;
      const headerLines = [`HTTP/2 ${response.status}`];
      if (response.contentType) headerLines.push(`content-type: ${response.contentType}`);
      response.xRobotsTag.forEach((value) => headerLines.push(`x-robots-tag: ${value}`));
      headerInput.value = headerLines.join("\n");
      const htmlSignals: string[] = [];
      if (response.canonical) htmlSignals.push(`<link rel="canonical" href="${response.canonical}">`);
      if (response.metaRobots.length) htmlSignals.push(`<meta name="robots" content="${response.metaRobots.join(", ")}">`);
      htmlInput.value = htmlSignals.join("\n");
      return true;
    };

    const setList = (selector: string, items: string[]) => {
      const list = document.querySelector<HTMLUListElement>(selector)!;
      list.replaceChildren();
      items.forEach((item) => {
        const li = document.createElement("li");
        li.textContent = item;
        list.append(li);
      });
    };

    const inspectPasted = (completion = "Pasted evidence inspected locally. No URL was requested.") => {
      const rawHeaders = headerInput.value.trim();
      const rawHtml = htmlInput.value.trim();
      if (!rawHeaders && !rawHtml) {
        results.hidden = true;
        status.textContent = "Paste headers or HTML before inspecting.";
        return;
      }

      const observed: string[] = [];
      const inferred: string[] = [];
      const unknown: string[] = [];
      const lines = rawHeaders.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
      const statusLine = lines.find((line) => /^HTTP\//i.test(line));
      const headers = new Map<string, string[]>();

      lines.filter((line) => !/^HTTP\//i.test(line)).forEach((line) => {
        const split = line.indexOf(":");
        if (split < 1) return;
        const name = line.slice(0, split).trim().toLowerCase();
        const value = line.slice(split + 1).trim();
        headers.set(name, [...(headers.get(name) ?? []), value]);
      });

      if (statusLine) {
        observed.push(`Status line: ${statusLine}`);
        const code = Number(statusLine.match(/\s(\d{3})(?:\s|$)/)?.[1]);
        if (code >= 300 && code < 400) {
          inferred.push(headers.has("location")
            ? "This response is a redirect with an explicit destination."
            : "This is a redirect status, but no Location header was present in the pasted block.");
        } else if (code >= 400) {
          inferred.push("The pasted response represents an error response, not an indexable success response.");
        } else if (code >= 200 && code < 300) {
          inferred.push("The pasted response is a successful HTTP response; indexability still depends on directives and content.");
        }
      } else if (rawHeaders) {
        unknown.push("No HTTP status line was found in the pasted header block.");
      }

      ["location", "x-robots-tag", "content-type", "cache-control", "link"].forEach((name) => {
        (headers.get(name) ?? []).forEach((value) => observed.push(`${name}: ${value}`));
      });

      const xRobots = (headers.get("x-robots-tag") ?? []).join(", ").toLowerCase();
      if (xRobots.includes("noindex")) inferred.push("The observed X-Robots-Tag contains noindex.");

      if (rawHtml) {
        const documentCopy = new DOMParser().parseFromString(rawHtml, "text/html");
        const canonical = documentCopy.querySelector<HTMLLinkElement>('link[rel~="canonical"]')?.href;
        const robots = documentCopy.querySelector<HTMLMetaElement>('meta[name="robots" i]')?.content;
        const title = documentCopy.querySelector("title")?.textContent?.trim();
        if (canonical) observed.push(`HTML canonical: ${canonical}`);
        else unknown.push("No HTML canonical link was found in the pasted source.");
        if (robots) {
          observed.push(`HTML robots meta: ${robots}`);
          if (robots.toLowerCase().includes("noindex")) inferred.push("The observed HTML robots directive contains noindex.");
        } else {
          unknown.push("No HTML robots meta directive was found in the pasted source.");
        }
        if (title) observed.push(`HTML title: ${title}`);
        if (canonical && headers.has("location")) {
          const location = headers.get("location")![0];
          inferred.push(canonical === new URL(location, canonical).href
            ? "The pasted canonical and redirect destination resolve to the same URL."
            : "The pasted canonical and redirect destination differ; verify the final response.");
        }
      } else {
        unknown.push("Canonical and HTML robots directives were not checked because no HTML was pasted.");
      }

      unknown.push("Final redirect destination, rendered content, network timing, DNS resolution, and live index state were not fetched or verified.");
      setList("#observed-list", observed.length ? observed : ["No supported status, header, or HTML signals were recognized."]);
      setList("#inferred-list", inferred.length ? inferred : ["No inference was made from the pasted evidence."]);
      setList("#unknown-list", unknown);
      document.querySelector("#observation-time")!.textContent = `ANALYSED ${new Date().toISOString()}`;
      results.hidden = false;
      status.textContent = `${completion} The result is open below.`;
      requestAnimationFrame(() => results.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "start",
      }));
    };

    const inspect = async () => {
      const raw = headerInput.value.trim();
      const isSingleUrl = raw && !raw.includes("\n") && !/^HTTP\//i.test(raw);
      if (!isSingleUrl) {
        inspectPasted();
        return;
      }
      inspectButton.disabled = true;
      results.hidden = true;
      status.textContent = "Fetching the public response safely …";
      try {
        const normalized = normalizePublicUrl(raw);
        const report = await runCrawlerCheck(normalized);
        if (!loadResponse({
          status: report.fetchFacts.status,
          contentType: report.fetchFacts.contentType,
          xRobotsTag: report.indexability.xRobotsTag,
          canonical: report.indexability.canonical.url,
          metaRobots: report.indexability.metaRobots,
        })) {
          status.textContent = "The live check returned no HTTP status. No response evidence was invented.";
          return;
        }
        inspectPasted(report.fetchFacts.cacheState === "hit"
          ? "Cached live response loaded. The gateway reuses successful results for no more than one hour."
          : "Fresh live response checked through the protected crawler gateway.");
      } catch (error) {
        status.textContent = error instanceof GatewayError && error.code === "VALIDATION_INVALID_INPUT"
          ? "Enter a public domain or HTTP(S) URL, for example contextter.com."
          : "The protected live check could not be completed. Pasted headers can still be inspected locally.";
      } finally {
        inspectButton.disabled = false;
      }
    };

    document.querySelector("#load-response-sample")!.addEventListener("click", () => {
      headerInput.value = sampleHeaders;
      htmlInput.value = sampleHtml;
      status.textContent = "Sample evidence loaded locally.";
      headerInput.focus();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-response-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        const preset = presets[button.dataset.responsePreset as keyof typeof presets];
        if (!preset) return;
        headerInput.value = preset.headers;
        htmlInput.value = preset.html;
        inspectPasted("Example response explained locally.");
      });
    });
    document.querySelector("#clear-response")!.addEventListener("click", () => {
      headerInput.value = "";
      htmlInput.value = "";
      results.hidden = true;
      status.textContent = "Local input cleared.";
      headerInput.focus();
    });
    inspectButton.addEventListener("click", inspect);

    const transferred = sessionStorage.getItem("analysespider.http-response");
    if (transferred && new URLSearchParams(window.location.search).get("from") === "crawler-check") {
      sessionStorage.removeItem("analysespider.http-response");
      try {
        const response = JSON.parse(transferred) as TransferredResponse;
        if (loadResponse(response)) inspectPasted("Response evidence transferred from the main URL check.");
      } catch {
        status.textContent = "The transferred response could not be read. Enter the URL again for a fresh check.";
      }
    }

    const transferredUrl = sessionStorage.getItem("analysespider.response-url");
    if (transferredUrl && new URLSearchParams(window.location.search).get("from") === "redirect-chain") {
      sessionStorage.removeItem("analysespider.response-url");
      headerInput.value = transferredUrl;
      status.textContent = "Final URL transferred from the redirect check. Select Inspect response to fetch it.";
      headerInput.focus();
    }
  </script>
</BaseLayout>
