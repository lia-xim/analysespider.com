---
import ResourceIndex from "../../components/ResourceIndex.astro";
import { blogPosts, formatDate } from "../../data/content";

const entries = blogPosts.map((post) => ({
  title: post.title,
  description: post.description,
  href: `/blog/${post.slug}`,
  meta: `${post.eyebrow} · ${formatDate(post.publishedAt)} · ${post.readingMinutes} min`,
}));
---
<ResourceIndex
  title="Technical SEO articles"
  pageTitle="Technical SEO and crawling articles — AnalyseSpider"
  description="Evidence-led articles about crawler logs, redirects, response interpretation and safe handling of diagnostic data."
  intro="Practical articles that answer one technical question in enough depth to support a real decision. No invented benchmarks, customers or field results."
  canonicalPath="/blog"
  index="40"
  entries={entries}
  note="Articles are dated and evidence-led. Stable procedures also live in Guides; changing protocol and crawler facts are tied to primary sources."
/>
