---
import ResourceIndex from "../../components/ResourceIndex.astro";
import { blogPosts, formatDate } from "../../data/content";

const entries = blogPosts.map((post) => ({
  title: post.title,
  description: post.description,
  href: `/blog/${post.slug}`,
  meta: `${post.eyebrow} · ${formatDate(post.publishedAt)} · ${post.readingMinutes} min`,
}));
---
<ResourceIndex
  title="Lab notes"
  pageTitle="Web diagnostics lab notes — AnalyseSpider"
  description="Short evidence-led notes on crawler logs, redirects, response interpretation, and safe handling of diagnostic data."
  intro="Small technical notes built around one mistake, one evidence boundary, or one decision rule. No invented benchmarks, customers, or field results."
  canonicalPath="/blog"
  index="40"
  entries={entries}
  note="Lab notes are dated editorial observations. Stable procedures live in Guides; protocol definitions and changing crawler details live in Reference."
/>
