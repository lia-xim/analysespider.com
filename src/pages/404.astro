---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
---
<BaseLayout
  title="Page not found — AnalyseSpider"
  description="The requested AnalyseSpider path was not found. Use the explicit legacy map or return to the diagnostics library."
  indexing="noindex"
  includeCanonical={false}
  includeStructuredData={false}
>
  <section class="not-found">
    <div>
      <p class="kicker">HTTP 404</p>
      <h1>Path not found.</h1>
      <p>Unknown and unrelated legacy paths are not redirected to the homepage. Use the legacy map to find an explicitly reviewed successor.</p>
      <div class="hero-actions">
        <a class="button primary" href="/legacy">Open legacy map <ArrowIcon /></a>
        <a class="text-link" href="/">Return home <ArrowIcon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
