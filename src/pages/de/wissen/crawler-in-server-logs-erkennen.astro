import GermanGuidePage from "../../../components/GermanGuidePage.astro";
const sections = [
  { heading: "Ein Logeintrag ist eine Serverbeobachtung", paragraphs: ["Eine Access-Logzeile kann zeigen, dass eine Anfrage eine bestimmte Logging-Schicht erreicht hat. Typische Felder sind IP-Adresse, Zeit, Methode, Pfad, Status, Bytes, Referrer und User-Agent. Welche Felder wirklich vorhanden sind, hängt vom konfigurierten Logformat ab.", "CDN oder Reverse Proxy können die sichtbare Client-Adresse verändern. Halte deshalb Quelle, Host, Zeitraum und Zeitzone des Exports fest."] },
  { heading: "Crawler zunächst als Kandidaten zählen", paragraphs: ["Filtere die User-Agent-Spalte nach aktuellen Tokens und behalte den Originalwert. Nenne das Ergebnis behauptete oder gemeldete Crawler-Aufrufe. Jeder Client kann diesen Text kopieren.", "Gruppiere danach nach Statusfamilie und Pfad. Ein 404 für Bingbot oder ein 429 für GPTBot ist ein konkreter Prüfpunkt. Fehlende Requests beweisen dagegen nicht, dass eine Seite unauffindbar ist."] },
  { heading: "Identität nur dann verifizieren, wenn sie die Entscheidung ändert", paragraphs: ["Vor einer Firewall-Freigabe, einem Incident oder einem veröffentlichten Betreiber-Report solltest du die IP mit der aktuellen Methode des Bot-Betreibers prüfen. Google dokumentiert veröffentlichte Bereiche sowie Reverse- und anschließende Forward-DNS-Prüfung.", "Speichere Methode und Zeitpunkt neben dem Ergebnis. Adressbereiche und Dokumentation können sich ändern."], callout: "Teile möglichst Aggregate statt rohe Logs. Query-Parameter, IP-Adressen und Referrer können personenbezogene oder vertrauliche Daten enthalten." },
];
