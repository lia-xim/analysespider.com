import GermanGuidePage from "../../../components/GermanGuidePage.astro";
const sections = [
  { heading: "Googlebot und AI-Crawler getrennt testen", paragraphs: ["robots.txt gruppiert Regeln nach User-agent-Produkt-Token. Googlebot steht für Google Search. OAI-SearchBot betrifft die ChatGPT-Suche, GPTBot mögliches OpenAI-Training. Auch Claude veröffentlicht getrennte Tokens für Suche, Training und nutzerveranlasste Abrufe. Ein allgemeines Label wie AI-Bot reicht deshalb nicht für einen belastbaren Test.", "Ein User-Agent-String im Log ist nur eine Behauptung. robots.txt steuert Zugriff; sie authentifiziert den Request nicht."] },
  { heading: "Die spezifischste passende Regel entscheidet", paragraphs: ["Nach RFC 9309 werden passende Gruppen und Pfadmuster ausgewertet. Die längste passende Regel gewinnt; bei gleicher Länge erhält Allow Vorrang. Ein Stern kann Zeichenfolgen abdecken, ein Dollarzeichen das Pfadende markieren."], bullets: ["Teste mit dem exakten Pfad einschließlich relevanter Query.", "Prüfe wiederholte Gruppen desselben Tokens gemeinsam.", "Wenn keine exakte Gruppe existiert, kann die Stern-Gruppe gelten.", "robots.txt selbst ist implizit erreichbar."] },
  { heading: "Allow und Disallow an einer konkreten URL prüfen", paragraphs: ["Ein robots.txt Tester braucht immer zwei Eingaben: den Crawler-Token und den Zielpfad. Eine Regel für /intern/ sagt ohne den konkreten Pfad noch nicht, ob /intern/vorschau.html erlaubt oder blockiert ist.", "Teste nicht nur die Startseite. Nimm genau die URL, deren Abruf du erklären möchtest, und dokumentiere die gewinnende Regel. So bleibt das Ergebnis reproduzierbar, wenn später weitere Gruppen oder Ausnahmen hinzukommen."] },
  { heading: "Crawling ist nicht Indexierung", paragraphs: ["Eine Disallow-Regel verhindert in erster Linie den Abruf. Sie ist kein verlässlicher Weg, eine bekannte URL aus Suchergebnissen zu entfernen. Ein noindex muss vom Crawler gelesen werden können; blockierst du den Abruf, kann genau das scheitern.", "Prüfe zusätzlich HTTP-Status, Content-Type, Meta-Robots, X-Robots-Tag und Firewall-Verhalten. Eine Allow-Entscheidung garantiert keinen Besuch."], callout: "Für vertrauliche Inhalte brauchst du Authentifizierung. robots.txt ist öffentlich und keine Zugriffskontrolle." },
];
---
<GermanGuidePage title="robots.txt für Googlebot und AI-Crawler testen" description="Prüfe Allow- und Disallow-Regeln für Googlebot, ChatGPT- und Claude-Crawler an einem konkreten Pfad und verstehe die Grenzen der robots.txt." canonicalPath="/de/wissen/robots-txt-testen" alternatePath="/guides/test-robots-txt-rules" intro="Eine robots.txt-Regel wirkt nur für den passenden Crawler und Pfad. Ein robots.txt Test muss deshalb beides exakt benennen – nicht nur nach einem Wort in der Datei suchen." answer="Wähle den echten Produkt-Token, teste den vollständigen Zielpfad und lies die spezifischste passende Allow- oder Disallow-Regel. Danach prüfst du separat, ob die Datei live erreichbar ist und ob andere Indexierungsdirektiven gelten." sections={sections} sources={[{label:"RFC 9309 — Robots Exclusion Protocol",href:"https://www.rfc-editor.org/rfc/rfc9309.html",note:"Normative Gruppen-, Matching- und Abrufregeln."},{label:"Google: Einführung in robots.txt",href:"https://developers.google.com/search/docs/crawling-indexing/robots/intro",note:"Crawling-Grenzen und Unterschied zur Indexierung."}]} tool={{href:"/de/tools/robots-regel-test",label:"robots.txt für einen Crawler testen",note:"Wähle Googlebot, ChatGPT oder Claude und prüfe eine öffentliche URL oder bereits kopierte Regeln."}} updatedAt={{iso:"2026-08-31",label:"31. August 2026"}} />
