---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
const groups = [
  { title: "Crawling and indexing", links: [
    ["How can a page appear in AI search?", "Separate crawler access, search eligibility and later source selection.", "/guides/appear-in-ai-search"],
    ["Why is my page not indexed?", "Check the status, robots directives and canonical in a useful order.", "/guides/http-response-debugging"],
    ["How does robots.txt work?", "Understand which bot can request which URL.", "/guides/test-robots-txt-rules"],
    ["How do I check a real crawler?", "Use the user agent, IP ranges and DNS evidence correctly.", "/reference/crawler-verification-methods"],
  ]},
  { title: "Redirects and HTTP", links: [
    ["How do I read a redirect chain?", "Check every hop and record the final destination.", "/guides/redirect-chain-analysis"],
    ["What do HTTP status codes mean?", "Keep protocol meaning separate from an SEO conclusion.", "/reference/http-status-codes"],
    ["Which robots directive wins?", "Read meta robots and X-Robots-Tag separately.", "/reference/robots-directives"],
  ]},
  { title: "Server logs and bot traffic", links: [
    ["What is recorded in a server log?", "Confirm the fields, format and limits before analysis.", "/guides/log-file-analysis"],
    ["How do I find crawler requests?", "Filter claimed bots and verify important identities.", "/guides/crawler-log-analysis"],
    ["What can an IP address show?", "Understand network ranges without identifying a person or exact place.", "/guides/ip-geolocation-data"],
  ]},
];
---
<BaseLayout
  title="Learn technical SEO without the jargon — AnalyseSpider"
  description="Plain-language guides to crawling, indexing, robots.txt, redirects, HTTP responses and server logs."
  canonicalPath="/guides"
  alternatePath="/de/wissen"
  bodyClass="simple-content"
>
  <header class="simple-page-lead">
    <h1>Learn technical SEO without the jargon.</h1>
    <p>Each guide answers one practical question. Start with the problem you can see on your website today.</p>
  </header>
  <section class="article-entry-strip" aria-label="Latest in-depth article">
    <span>New guide</span><a href="/guides/appear-in-ai-search"><strong>How can a page appear in AI search?</strong><small>OpenAI, Google and Anthropic controls explained from primary sources.</small><ArrowIcon /></a>
  </section>
  <section class="knowledge-groups" aria-label="Knowledge topics">
    {groups.map((group) => (
      <div class="knowledge-group">
        <h2>{group.title}</h2>
        <div>
          {group.links.map((link) => (
            <a href={link[2]}>
              <span><strong>{link[0]}</strong><small>{link[1]}</small></span>
              <ArrowIcon />
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
  <section class="fanout-knowledge" aria-labelledby="fanout-knowledge-heading">
    <div>
      <h2 id="fanout-knowledge-heading">Planning new content?</h2>
      <p>SEO Fan-out Explorer helps you decide whether a topic needs a new page, a new section, better evidence or no new URL at all.</p>
      <p class="disclosure">SEO Fan-out and AnalyseSpider are operated by Matthias Ramahi. This is a related tool, not an independent recommendation.</p>
    </div>
    <a class="button secondary" href="https://seo-fanout.com/tool/">Start an SEO page decision</a>
  </section>
</BaseLayout>
