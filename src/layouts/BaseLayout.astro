---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/accessibility.css";
import "../styles/polish.css";
import "../styles/polish-final.css";
import "../styles/layout-final.css";
import "../styles/content.css";
import "../styles/overflow-fixes.css";
import "../styles/navigation-expansion.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  bodyClass?: string;
  pageType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  bodyClass = "",
  pageType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonical = new URL(canonicalPath, site.origin).toString();
const robots = site.indexing === "public" ? "index, follow" : "noindex, nofollow, noarchive";
const operatorEntity = {
  "@type": "Person",
  "@id": site.operator.schemaId,
  name: site.operator.name,
  email: site.operator.email,
  telephone: site.operator.telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.operator.streetAddress,
    postalCode: site.operator.postalCode,
    addressLocality: site.operator.addressLocality,
    addressCountry: site.operator.addressCountry,
  },
};
const structuredData = pageType === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title.replace(/ — AnalyseSpider$/, ""),
      description,
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      mainEntityOfPage: canonical,
      author: { "@type": "Organization", name: site.name, url: site.origin },
      publisher: operatorEntity,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
      isPartOf: { "@type": "WebSite", name: site.name, url: site.origin, publisher: operatorEntity },
    };
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0f0f" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {pageType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-frame">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </body>
</html>
