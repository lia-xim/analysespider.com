---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import { getAlternatePath, getLocale, type Locale } from "../data/i18n";
import "../styles/global.css";
import "../styles/accessibility.css";
import "../styles/polish.css";
import "../styles/polish-final.css";
import "../styles/layout-final.css";
import "../styles/content.css";
import "../styles/overflow-fixes.css";
import "../styles/navigation-expansion.css";
import "../styles/simple-redesign.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  bodyClass?: string;
  pageType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  indexing?: "inherit" | "noindex";
  includeCanonical?: boolean;
  includeStructuredData?: boolean;
  includeFeedDiscovery?: boolean;
  lang?: Locale;
  alternatePath?: string | null;
  breadcrumbs?: { name: string; path: string }[];
  socialImagePath?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  bodyClass = "",
  pageType = "website",
  publishedTime,
  modifiedTime,
  indexing = "inherit",
  includeCanonical = true,
  includeStructuredData = true,
  includeFeedDiscovery = false,
  lang = getLocale(Astro.url.pathname),
  alternatePath = getAlternatePath(canonicalPath),
  breadcrumbs = [],
  socialImagePath = "/og/analysespider-editorial.png",
} = Astro.props;
const canonical = new URL(canonicalPath, site.origin).toString();
const alternateLocale: Locale = lang === "en" ? "de" : "en";
const alternateUrl = alternatePath ? new URL(alternatePath, site.origin).toString() : null;
const socialImage = new URL(socialImagePath, site.origin).toString();
const robots = indexing === "noindex"
  ? "noindex, follow"
  : site.indexing === "public"
    ? "index, follow"
    : "noindex, nofollow, noarchive";
const operatorEntity = {
  "@type": "Person",
  "@id": site.operator.schemaId,
  name: site.operator.name,
  url: `${site.origin}/about#editor`,
  email: site.operator.email,
  telephone: site.operator.telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.operator.streetAddress,
    postalCode: site.operator.postalCode,
    addressLocality: site.operator.addressLocality,
    addressCountry: site.operator.addressCountry,
  },
};
const websiteEntity = {
  "@type": "WebSite",
  "@id": `${site.origin}/#website`,
  name: site.name,
  url: site.origin,
  publisher: { "@id": site.operator.schemaId },
};
const collectionPaths = new Set(["/tools", "/guides", "/crawlers", "/blog", "/reference", "/for", "/de/tools", "/de/wissen", "/de/crawler"]);
const schemaType = pageType === "article"
  ? "TechArticle"
  : canonicalPath.startsWith("/tools/") || canonicalPath.startsWith("/de/tools/")
    ? "WebApplication"
    : collectionPaths.has(canonicalPath)
      ? "CollectionPage"
      : "WebPage";
const pageEntity = {
  "@type": schemaType,
  "@id": canonical,
  name: title.replace(/ — AnalyseSpider$/, ""),
  headline: pageType === "article" ? title.replace(/ — AnalyseSpider$/, "") : undefined,
  description,
  url: canonical,
  inLanguage: lang,
  mainEntityOfPage: pageType === "article" ? canonical : undefined,
  datePublished: pageType === "article" ? publishedTime : undefined,
  dateModified: pageType === "article" ? (modifiedTime ?? publishedTime) : undefined,
  author: pageType === "article" ? { "@id": site.operator.schemaId } : undefined,
  publisher: pageType === "article" ? { "@id": site.operator.schemaId } : undefined,
  image: socialImage,
  applicationCategory: schemaType === "WebApplication" ? "DeveloperApplication" : undefined,
  operatingSystem: schemaType === "WebApplication" ? "Any" : undefined,
  browserRequirements: schemaType === "WebApplication" ? "JavaScript enabled" : undefined,
  isPartOf: { "@id": `${site.origin}/#website` },
};
const breadcrumbEntity = breadcrumbs.length > 1 ? {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.path, site.origin).toString(),
  })),
} : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [operatorEntity, websiteEntity, pageEntity, breadcrumbEntity].filter(Boolean),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {includeFeedDiscovery && <link rel="alternate" type="application/atom+xml" title="AnalyseSpider articles" href="/feed.xml" />}
    {includeCanonical && <link rel="canonical" href={canonical} />}
    {alternateUrl && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alternateUrl && <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang="x-default" href={lang === "en" ? canonical : alternateUrl} />}
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {includeCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Abstract crawler paths connecting web pages and server responses" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {pageType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {includeStructuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {site.analytics.enabled && <script is:inline defer src={site.analytics.scriptUrl} data-website-id={site.analytics.websiteId} data-domains={site.analytics.domains} data-do-not-track="true" data-exclude-search="true" data-exclude-hash="true" data-performance="true"></script>}
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{lang === "de" ? "Zum Inhalt" : "Skip to content"}</a>
    <div class="page-frame">
      <SiteHeader />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<script>
  import { mountAnalytics } from "../lib/analytics";
  mountAnalytics();
</script>
