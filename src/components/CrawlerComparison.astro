---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "./ArrowIcon.astro";
import type { Locale } from "../data/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === "de";

const sources = {
  google: "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers",
  googleVerify: "https://developers.google.com/crawling/docs/crawlers-fetchers/verify-google-requests",
  bing: "https://www.bing.com/webmasters/help/help/which-crawlers-does-bing-use-8c184ec0",
  bingVerify: "https://www.bing.com/webmasters/help/how-to-verify-bingbot-3905dc26",
  openai: "https://developers.openai.com/api/docs/bots",
  anthropic: "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler",
};

const copy = de ? {
  title: "Suchmaschinen- und AI-Crawler verstehen — AnalyseSpider",
  description: "Verstehe, was Googlebot, Bingbot, OAI-SearchBot, GPTBot und Claude-Crawler tun, wie du sie steuerst und wie du echte Anfragen prüfst.",
  canonical: "/de/crawler", alternate: "/crawlers",
  headline: "Welcher Crawler besucht deine Website — und warum?",
  intro: "Google, Bing, ChatGPT und Claude verwenden unterschiedliche Bots für Suche, Training und einzelne Nutzeranfragen. Hier findest du die Namen, die richtige robots.txt-Regel und die Belege, die du für eine echte Prüfung brauchst.",
  imageAlt: "Grafik eines Crawlers zwischen Webseiten, Serverantworten und dem öffentlichen Web",
  imageCaption: "Ein Crawl verbindet eine Anfrage mit einer Serverantwort. Indexierung, Ranking und Zitation passieren erst später.",
  jumpLabel: "Direkt zur Frage",
  jumps: [["#rollen", "Welcher Bot macht was?"], ["#vergleich", "Crawler vergleichen"], ["#verifizieren", "Bot verifizieren"], ["#werkzeuge", "Crawler testen"]],
  roleHeading: "Beginne mit der Aufgabe, nicht mit dem Bot-Namen.",
  roleIntro: "Ein Name wie „AI-Crawler“ ist zu ungenau. Entscheidend ist, welches System den Abruf ausgelöst hat.",
  roles: [
    ["Für klassische Suche", "Googlebot und Bingbot", "Sie entdecken Seiten für Suchindizes. Erreichbarkeit ist nötig, aber keine Garantie für Indexierung oder Ranking."],
    ["Für AI-Suche", "OAI-SearchBot und Claude-SearchBot", "Sie unterstützen die Suchfunktionen ihrer Betreiber. Google verwendet für seine Suchoberflächen weiterhin die Regeln der Google-Suche; Google-Extended ist dafür nicht zuständig."],
    ["Für mögliches Modelltraining", "GPTBot und ClaudeBot", "Diese Bots lassen sich getrennt von den Suchbots steuern. Eine Sperre für Training muss deshalb nicht automatisch die AI-Suche sperren."],
    ["Für eine Nutzeranfrage", "ChatGPT-User und Claude-User", "Sie können eine Seite abrufen, weil ein Mensch gerade danach fragt. So ein Abruf beweist keine automatische Aufnahme in einen Suchindex."],
  ],
  stages: [
    ["1. Abruf", "Ein Client fordert eine URL an und erhält Status, Header und HTML."],
    ["2. Verarbeitung", "Ein Such- oder AI-System kann den Inhalt speichern, rendern oder verwerfen."],
    ["3. Auswahl", "Eine spätere Suche oder Antwort kann die Seite auswählen — muss es aber nicht."],
  ],
  tableHeading: "Crawler und Steuerung im direkten Vergleich",
  tableIntro: "Die Rollen stammen aus der aktuellen Dokumentation der Betreiber. Ein User-Agent ist kopierbarer Text und allein kein Identitätsnachweis.",
  headers: ["Crawler oder Token", "Betreiber und Aufgabe", "Steuerung", "Prüfung", "Preset"],
  source: "Offizielle Quelle", checked: "Zuletzt gegen Primärquellen geprüft: 28. August 2026",
  test: "Regel testen",
  evidenceHeading: "Wie sicher ist ein Bot-Nachweis?",
  evidenceIntro: "Verwende nur so viel Beweisstärke, wie deine Entscheidung verlangt. Für eine Statistik reicht oft eine markierte Vermutung. Für eine Firewall-Freigabe nicht.",
  evidence: [
    ["Behauptet", "Der User-Agent enthält Googlebot, GPTBot oder ClaudeBot.", "Nützlich zum Filtern. Leicht zu fälschen."],
    ["Beobachtet", "Server-Log, IP-Adresse, Zeitpunkt, URL und Statuscode passen zusammen.", "Belegt den Request — noch nicht den Betreiber."],
    ["Unterstützt", "Die IP liegt in einem aktuell veröffentlichten Bereich des Betreibers.", "Stärkerer Hinweis. Listen können sich ändern."],
    ["Verifiziert", "Die vom Betreiber beschriebene IP- oder Reverse-/Forward-DNS-Prüfung ist bestanden.", "Geeignet für wichtige Zugriffsentscheidungen."],
  ],
  logHeading: "Was dir ein Logeintrag wirklich sagt",
  logText: "Ein bestätigter Request mit Status 200 zeigt: Dieser Bot konnte diese URL zu diesem Zeitpunkt abrufen. Er zeigt nicht, ob JavaScript vollständig verarbeitet, die Seite indexiert oder später als Quelle zitiert wurde. Ein 403 oder 429 ist dagegen ein konkreter Hinweis auf Firewall-, Bot-Schutz- oder Lastprobleme.",
  logSteps: ["User-Agent als Kandidat markieren.", "IP und Zeitpunkt aus derselben Logzeile sichern.", "IP nach der Methode des Betreibers prüfen.", "Statuscode, URL und Antwortgröße auswerten."],
  logAction: "Crawler-Logs analysieren",
  verifyGuide: "Verifikationsmethoden vergleichen",
  toolsHeading: "Von der URL zum belastbaren Befund",
  toolsIntro: "Die Werkzeuge beantworten verschiedene Teile derselben Diagnose. Starte mit dem Material, das du bereits hast.",
  tools: [
    ["Crawler-Analyse-Tool", "Prüft eine öffentliche URL, robots.txt, Indexierungsdirektiven und das erste HTML.", "/de/tools/crawler-sicht"],
    ["robots.txt-Tester", "Zeigt, welche Regel für Googlebot, OAI-SearchBot, GPTBot oder Claude gewinnt.", "/de/tools/robots-regel-test"],
    ["Crawler-Log-Analyse", "Findet Bot-Kandidaten, Statuscodes und häufige Pfade in Apache- oder Nginx-Logs.", "/de/tools/server-log-analyse"],
  ],
  open: "Tool öffnen",
  eligibleHeading: "Was eine Seite für Suche und AI technisch braucht",
  eligibleSteps: ["Eine stabile öffentliche HTTPS-URL mit brauchbarer 200-Antwort.", "Eine robots.txt-Regel, die genau den gewünschten Bot nicht blockiert.", "Keine unbeabsichtigte Sperre durch CDN, Firewall oder Bot-Schutz.", "Eine klare Kernantwort und wichtige Links im Server-HTML.", "Konsistente interne Links, Canonicals und Sitemap-Einträge.", "Eigene, überprüfbare Inhalte statt austauschbarer Zusammenfassungen."],
  eligibleNote: "Das schafft technische Eignung. Indexierung, Ranking oder Zitation bleiben Entscheidungen des jeweiligen Systems.",
  guide: "Leitfaden zur AI-Suche lesen",
  auditHeading: "Und was ist mit Screaming Frog, Sitebulb oder Site-Audit-Tools?",
  auditText: "Diese Crawler lösen eine andere Aufgabe: Sie prüfen eine Website im Auftrag des Betreibers. Ein fairer Vergleich braucht dieselbe unveränderte Testwebsite, dieselben Einstellungen und mehrere Läufe. Wichtige Messwerte sind gefundene URLs, JavaScript-Verarbeitung, Redirect- und Canonical-Logik, Exporte, Laufzeit, Limits und Kosten. AnalyseSpider veröffentlicht deshalb noch keinen künstlichen Sieger.",
  fixtureLink: "Testprotokoll und Fixture ansehen",
  sourcesHeading: "Primärquellen und Pflege",
  sourcesIntro: "Crawler-Namen, IP-Bereiche und Produktrollen ändern sich. Diese Seite stützt sich deshalb auf die Dokumentation der Betreiber und nennt das Prüfdatum.",
  relatedHeading: "Welche Themen und Quellen tauchen in AI-Antworten auf?",
  relatedText: "AI Fanout untersucht echte Fragevarianten mit OpenAI und Gemini. Das ergänzt die technische Crawler-Prüfung, verspricht aber keine Sichtbarkeit.",
  aiLabel: "AI Fanout öffnen",
  disclosure: "AnalyseSpider und AI Fanout werden von Matthias Ramahi betrieben. Der Link ist ein verwandtes Werkzeug, keine unabhängige Empfehlung.",
} : {
  title: "Understand search and AI crawlers — AnalyseSpider",
  description: "Understand what Googlebot, Bingbot, OAI-SearchBot, GPTBot and Claude crawlers do, how to control them and how to verify real requests.",
  canonical: "/crawlers", alternate: "/de/crawler",
  headline: "Which crawler visits your site — and why?",
  intro: "Google, Bing, ChatGPT and Claude use different bots for search, training and individual user requests. Find the right name, the relevant robots.txt control and the evidence needed to verify a real request.",
  imageAlt: "Diagram of a crawler moving between web pages, server responses and the public web",
  imageCaption: "A crawl connects a request to a server response. Indexing, ranking and citation happen later.",
  jumpLabel: "Jump to a question",
  jumps: [["#rollen", "What does each bot do?"], ["#vergleich", "Compare crawlers"], ["#verifizieren", "Verify a bot"], ["#werkzeuge", "Test crawler access"]],
  roleHeading: "Start with the job, not the bot name.",
  roleIntro: "A label such as “AI crawler” is too broad. What matters is which system triggered the fetch.",
  roles: [
    ["For conventional search", "Googlebot and Bingbot", "They discover pages for search indexes. Access is necessary, but does not guarantee indexing or ranking."],
    ["For AI search", "OAI-SearchBot and Claude-SearchBot", "They support their operators’ search products. Google search experiences still use Google Search controls; Google-Extended is not a search inclusion control."],
    ["For possible model training", "GPTBot and ClaudeBot", "These bots can be controlled separately from search bots. Blocking training therefore need not block AI search automatically."],
    ["For a user request", "ChatGPT-User and Claude-User", "They may fetch a page because a person asks for it now. That request is not proof of automatic search inclusion."],
  ],
  stages: [
    ["1. Fetch", "A client requests a URL and receives a status, headers and HTML."],
    ["2. Processing", "A search or AI system may store, render or discard the content."],
    ["3. Selection", "A later search or answer may select the page — or may not."],
  ],
  tableHeading: "Crawler roles and controls, side by side",
  tableIntro: "Roles come from current operator documentation. A user-agent is copyable text and cannot prove identity on its own.",
  headers: ["Crawler or token", "Operator and job", "Control", "Verification", "Preset"],
  source: "Official source", checked: "Last checked against primary sources: 28 August 2026",
  test: "Test rule",
  evidenceHeading: "How strong is your bot evidence?",
  evidenceIntro: "Use evidence proportionate to the decision. A labelled estimate may be enough for a report. It is not enough for a firewall allowlist.",
  evidence: [
    ["Claimed", "The user-agent contains Googlebot, GPTBot or ClaudeBot.", "Useful for filtering. Easy to spoof."],
    ["Observed", "Server log, IP, timestamp, URL and status belong to one request.", "Proves the request — not yet the operator."],
    ["Supported", "The IP falls within a current range published by the operator.", "Stronger support. Lists can change."],
    ["Verified", "The operator's documented IP or reverse-and-forward DNS check passes.", "Appropriate for consequential access decisions."],
  ],
  logHeading: "What a log entry really tells you",
  logText: "A verified request with status 200 shows that this bot fetched this URL at that time. It does not show whether JavaScript was fully processed, the page was indexed or the page was later cited. A 403 or 429, however, is concrete evidence of a firewall, bot-protection or capacity problem.",
  logSteps: ["Mark the user-agent as a candidate.", "Keep the IP and timestamp from the same line.", "Verify the IP using the operator's method.", "Read the status, URL and response size."],
  logAction: "Analyze crawler logs",
  verifyGuide: "Compare verification methods",
  toolsHeading: "From one URL to a defensible finding",
  toolsIntro: "Each tool answers a different part of the diagnosis. Start with the evidence already in front of you.",
  tools: [
    ["Crawler Analysis Tool", "Checks one public URL, robots.txt, indexing directives and the initial HTML.", "/tools/crawler-view"],
    ["Robots.txt Tester", "Shows which rule wins for Googlebot, OAI-SearchBot, GPTBot or Claude.", "/tools/robots-rule-tester"],
    ["Crawler Log Analyzer", "Finds bot candidates, status codes and busy paths in Apache or Nginx logs.", "/tools/log-file-inspector"],
  ],
  open: "Open tool",
  eligibleHeading: "What search and AI systems need from a page",
  eligibleSteps: ["A stable public HTTPS URL with a useful 200 response.", "A robots.txt rule that does not block the bot you intend to allow.", "No accidental denial by a CDN, firewall or bot-protection layer.", "A clear core answer and important links in server-rendered HTML.", "Consistent internal links, canonicals and sitemap entries.", "Original, verifiable content rather than interchangeable summaries."],
  eligibleNote: "This creates technical eligibility. Indexing, ranking and citation remain decisions made by each system.",
  guide: "Read the AI search guide",
  auditHeading: "What about Screaming Frog, Sitebulb and site-audit crawlers?",
  auditText: "They solve a different job: auditing a website for its operator. A fair comparison needs the same unchanged fixture, the same settings and several runs. Useful measures include discovered URLs, JavaScript handling, redirect and canonical logic, exports, runtime, limits and cost. AnalyseSpider therefore publishes no artificial winner yet.",
  fixtureLink: "View the test protocol and fixture",
  sourcesHeading: "Primary sources and maintenance",
  sourcesIntro: "Crawler names, IP ranges and product roles change. This page therefore links to operator documentation and records its review date.",
  relatedHeading: "Which topics and sources appear in AI answers?",
  relatedText: "AI Fanout explores real question variants with OpenAI and Gemini. It complements technical crawler checks but does not promise visibility.",
  aiLabel: "Open AI Fanout",
  disclosure: "AnalyseSpider and AI Fanout are operated by Matthias Ramahi. This is a related tool, not an independent recommendation.",
};

const rows = de ? [
  ["Googlebot", "Google · Suchindex", "robots.txt-Token Googlebot", "Google-IP-Liste oder Reverse- und Forward-DNS", sources.google],
  ["Bingbot", "Microsoft · Bing-Suchindex", "robots.txt-Token Bingbot", "Verify-Bingbot oder Reverse- und Forward-DNS", sources.bing],
  ["OAI-SearchBot", "OpenAI · ChatGPT-Suche", "Getrennt von GPTBot steuerbar", "User-Agent plus veröffentlichte OpenAI-IP-Bereiche", sources.openai],
  ["GPTBot", "OpenAI · mögliches Modelltraining", "Eigener robots.txt-Token", "User-Agent plus veröffentlichte OpenAI-IP-Bereiche", sources.openai],
  ["ChatGPT-User", "OpenAI · Nutzerabruf", "Keine Steuerung der Suchaufnahme", "User-Agent plus veröffentlichte OpenAI-IP-Bereiche", sources.openai],
  ["Claude-SearchBot", "Anthropic · Claude-Suche", "Eigener robots.txt-Token", "User-Agent plus veröffentlichte Anthropic-IP-Liste", sources.anthropic],
  ["ClaudeBot", "Anthropic · mögliches Modelltraining", "Getrennt vom Suchbot steuerbar", "User-Agent plus veröffentlichte Anthropic-IP-Liste", sources.anthropic],
  ["Claude-User", "Anthropic · Nutzerabruf", "Eigener robots.txt-Token", "User-Agent plus veröffentlichte Anthropic-IP-Liste", sources.anthropic],
  ["Google-Extended", "Google · Gemini-Training und bestimmte Grounding-Nutzungen", "Produkt-Token; beeinflusst Google Search nicht", "Kein eigener HTTP-User-Agent", sources.google],
] : [
  ["Googlebot", "Google · Search index", "Googlebot robots.txt token", "Google IP list or reverse and forward DNS", sources.google],
  ["Bingbot", "Microsoft · Bing search index", "Bingbot robots.txt token", "Verify Bingbot or reverse and forward DNS", sources.bing],
  ["OAI-SearchBot", "OpenAI · ChatGPT search", "Controlled separately from GPTBot", "User agent plus published OpenAI IP ranges", sources.openai],
  ["GPTBot", "OpenAI · possible model training", "Dedicated robots.txt token", "User agent plus published OpenAI IP ranges", sources.openai],
  ["ChatGPT-User", "OpenAI · user-triggered fetch", "Not a search inclusion control", "User agent plus published OpenAI IP ranges", sources.openai],
  ["Claude-SearchBot", "Anthropic · Claude search", "Dedicated robots.txt token", "User agent plus published Anthropic IP list", sources.anthropic],
  ["ClaudeBot", "Anthropic · possible model training", "Controlled separately from search", "User agent plus published Anthropic IP list", sources.anthropic],
  ["Claude-User", "Anthropic · user-triggered fetch", "Dedicated robots.txt token", "User agent plus published Anthropic IP list", sources.anthropic],
  ["Google-Extended", "Google · Gemini training and certain grounding uses", "Product token; does not affect Google Search", "No separate HTTP user agent", sources.google],
];

const sourceLinks = de ? [
  ["Google: Crawler und Google-Extended", sources.google], ["Google: Requests verifizieren", sources.googleVerify],
  ["Bing: Crawler", sources.bing], ["Bingbot verifizieren", sources.bingVerify],
  ["OpenAI: Crawler", sources.openai], ["Anthropic: Claude-Crawler", sources.anthropic],
] : [
  ["Google crawlers and Google-Extended", sources.google], ["Google request verification", sources.googleVerify],
  ["Bing crawlers", sources.bing], ["Verify Bingbot", sources.bingVerify],
  ["OpenAI crawlers", sources.openai], ["Anthropic crawler controls", sources.anthropic],
];
---
<BaseLayout title={copy.title} description={copy.description} canonicalPath={copy.canonical} alternatePath={copy.alternate} lang={locale} bodyClass="simple-content crawler-page crawler-library-page" breadcrumbs={[{ name: "AnalyseSpider", path: de ? "/de" : "/" }, { name: de ? "Crawler" : "Crawlers", path: copy.canonical }]}>
  <header class="crawler-library-hero">
    <div><h1>{copy.headline}</h1><p>{copy.intro}</p></div>
    <figure><img src="/og/analysespider-editorial.png" width="1536" height="1024" alt={copy.imageAlt} loading="eager" fetchpriority="high" /><figcaption>{copy.imageCaption}</figcaption></figure>
  </header>

  <nav class="crawler-jump-nav" aria-label={copy.jumpLabel}><strong>{copy.jumpLabel}</strong>{copy.jumps.map(([href, label]) => <a href={href}>{label}</a>)}</nav>

  <section class="crawler-role-section" id="rollen" aria-labelledby="crawler-role-heading">
    <header><h2 id="crawler-role-heading">{copy.roleHeading}</h2><p>{copy.roleIntro}</p></header>
    <div class="crawler-role-rows">{copy.roles.map(([label, bots, text]) => <article><span>{label}</span><h3>{bots}</h3><p>{text}</p></article>)}</div>
  </section>

  <section class="crawler-stage-strip" aria-label={de ? "Drei getrennte Stufen" : "Three separate stages"}>{copy.stages.map(([title, text]) => <div><strong>{title}</strong><span>{text}</span></div>)}</section>

  <section class="crawler-table-section" id="vergleich" aria-labelledby="crawler-table-heading">
    <header><h2 id="crawler-table-heading">{copy.tableHeading}</h2><p>{copy.tableIntro}</p><small>{copy.checked}</small></header>
    <div class="table-wrap crawler-table-wrap"><table class="crawler-table"><thead><tr>{copy.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{rows.map((row) => <tr><th scope="row"><strong>{row[0]}</strong><a href={row[4]} rel="noreferrer">{copy.source}</a></th><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td><td><a href={`${de ? "/de/tools/robots-regel-test" : "/tools/robots-rule-tester"}?crawler=${encodeURIComponent(row[0])}`}>{copy.test}</a></td></tr>)}</tbody></table></div>
  </section>

  <section class="crawler-evidence-section" id="verifizieren" aria-labelledby="crawler-evidence-heading">
    <header><h2 id="crawler-evidence-heading">{copy.evidenceHeading}</h2><p>{copy.evidenceIntro}</p></header>
    <ol>{copy.evidence.map(([level, proof, meaning]) => <li><strong>{level}</strong><div><p>{proof}</p><small>{meaning}</small></div></li>)}</ol>
  </section>

  <section class="crawler-log-reading"><div><h2>{copy.logHeading}</h2><p>{copy.logText}</p><div class="inline-actions"><a class="text-link" href={de ? "/de/tools/server-log-analyse" : "/tools/log-file-inspector"}>{copy.logAction} <ArrowIcon /></a><a href={de ? "/de/wissen/crawler-erkennen" : "/reference/crawler-verification-methods"}>{copy.verifyGuide}</a></div></div><ol>{copy.logSteps.map((step) => <li>{step}</li>)}</ol></section>

  <section class="crawler-tool-workflow" id="werkzeuge" aria-labelledby="crawler-tools-heading">
    <header><h2 id="crawler-tools-heading">{copy.toolsHeading}</h2><p>{copy.toolsIntro}</p></header>
    <div>{copy.tools.map(([title, text, href]) => <a href={href}><h3>{title}</h3><p>{text}</p><span>{copy.open} <ArrowIcon /></span></a>)}</div>
  </section>

  <section class="crawler-eligibility"><div><h2>{copy.eligibleHeading}</h2><p><strong>{copy.eligibleNote}</strong></p><a class="text-link" href={de ? "/de/wissen/in-ai-suche-erscheinen" : "/guides/appear-in-ai-search"}>{copy.guide} <ArrowIcon /></a></div><ul>{copy.eligibleSteps.map((step) => <li>{step}</li>)}</ul></section>
  <section class="audit-comparison-note"><h2>{copy.auditHeading}</h2><div><p>{copy.auditText}</p><a href="/lab/crawler-benchmarks">{copy.fixtureLink} <ArrowIcon /></a></div></section>

  <section class="crawler-source-section"><header><h2>{copy.sourcesHeading}</h2><p>{copy.sourcesIntro}</p><small>{copy.checked}</small></header><div>{sourceLinks.map(([label, href]) => <a href={href} rel="noreferrer">{label} <ArrowIcon /></a>)}</div></section>
  <section class="related-work related-fanout"><div><h2>{copy.relatedHeading}</h2><p>{copy.relatedText}</p></div><div class="related-actions"><a class="button secondary" href={de ? "https://ai-fanout.com/de" : "https://ai-fanout.com/"}>{copy.aiLabel}</a></div><p class="disclosure">{copy.disclosure}</p></section>
</BaseLayout>
