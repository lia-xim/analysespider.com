---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "./ArrowIcon.astro";
import type { Locale } from "../data/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === "de";
const copy = de ? {
  title: "Googlebot, Bingbot und AI-Crawler vergleichen — AnalyseSpider",
  description: "Vergleiche Aufgaben, robots.txt-Steuerung und Prüfmethoden von Suchmaschinen-, ChatGPT-, Claude- und Trainings-Crawlern.",
  canonical: "/de/crawler", alternate: "/crawlers",
  headline: "Crawler vergleichen, ohne ihre Aufgaben zu vermischen.",
  intro: "Ein Bot kann einen Suchindex aufbauen, Trainingsdaten abrufen oder eine Seite im Auftrag eines Nutzers öffnen. Diese Unterschiede entscheiden darüber, welche Regel du brauchst und was ein Logeintrag wirklich beweist.",
  explain: [
    ["Crawler", "ruft eine URL ab und erhält eine Serverantwort."],
    ["Index oder Suchsystem", "kann die gefundene Seite speichern und verarbeiten."],
    ["Antwort oder Ranking", "wählt später möglicherweise eine Seite aus — ohne Garantie."],
  ],
  tableHeading: "Veröffentlichte Aufgaben und Kontrollen",
  tableIntro: "Die Tabelle beschreibt die aktuelle Dokumentation der Betreiber. Ein kopierbarer User-Agent allein beweist keine Identität.",
  headers: ["Crawler oder Token", "Aufgabe", "robots.txt", "Identität prüfen"],
  source: "Primärquelle", checked: "Geprüft: 28. August 2026",
  eligibleHeading: "So wird eine Seite technisch auffindbar",
  eligibleSteps: ["Liefere eine stabile öffentliche HTTPS-URL mit brauchbarer 200-Antwort.", "Erlaube den passenden Suchcrawler in robots.txt und auf Seitenebene.", "Prüfe, ob CDN oder Firewall den Bot trotz Freigabe blockieren.", "Zeige die Kernantwort und wichtige Links bereits im Server-HTML.", "Nutze interne Links, Canonical und Sitemap konsistent.", "Veröffentliche eigene, überprüfbare Substanz statt vieler austauschbarer Seiten."],
  eligibleNote: "Das schafft technische Eignung. Es garantiert keine Indexierung, Platzierung oder Zitation.",
  guide: "Vollständigen AI-Suche-Leitfaden lesen",
  auditHeading: "Site-Audit-Crawler brauchen einen anderen Vergleich.",
  auditText: "Bei Contextter, Screaming Frog oder Sitebulb zählen gefundene URLs, Redirect- und Canonical-Behandlung, wiederholbare Läufe, Rohdatenzugang, Limits und Kosten. Einen Sieger nennen wir erst nach mehreren Läufen auf derselben unveränderten Testwebsite.",
  fixtureLink: "Unsere Test-Fixtures ansehen",
  relatedHeading: "Welche Fragen und Quellen erscheinen in AI-Antworten?",
  relatedText: "AI Fanout führt echte OpenAI- und Gemini-Abfragen aus. Das ergänzt die technische Crawler-Prüfung, verspricht aber keine Sichtbarkeit.",
  aiLabel: "AI Fanout öffnen",
  disclosure: "AnalyseSpider und AI Fanout werden von Matthias Ramahi betrieben. Der Link ist ein verwandtes Werkzeug, keine unabhängige Empfehlung.",
} : {
  title: "Compare Googlebot, Bingbot and AI crawlers — AnalyseSpider",
  description: "Compare the jobs, robots.txt controls and verification methods of search, ChatGPT, Claude and training crawlers.",
  canonical: "/crawlers", alternate: "/de/crawler",
  headline: "Compare crawlers without mixing their jobs.",
  intro: "A bot may build a search index, collect training data or open a page for a user. Those differences determine which control you need and what a log entry actually proves.",
  explain: [
    ["Crawler", "fetches a URL and receives a server response."],
    ["Index or search system", "may store and process the discovered page."],
    ["Answer or ranking", "may later select a page — with no guarantee."],
  ],
  tableHeading: "Published roles and controls",
  tableIntro: "This table describes current operator documentation. A copyable user-agent string alone does not prove identity.",
  headers: ["Crawler or token", "Job", "robots.txt", "Verify identity"],
  source: "Primary source", checked: "Checked: 28 August 2026",
  eligibleHeading: "How to make a page technically discoverable",
  eligibleSteps: ["Serve a stable public HTTPS URL with a useful 200 response.", "Allow the relevant search crawler in robots.txt and page directives.", "Check whether a CDN or firewall blocks it despite that allowance.", "Put the core answer and important links in server-rendered HTML.", "Keep internal links, canonical and sitemap consistent.", "Publish original, verifiable substance instead of many interchangeable pages."],
  eligibleNote: "That creates technical eligibility. It does not guarantee indexing, ranking or citation.",
  guide: "Read the complete AI search guide",
  auditHeading: "Site-audit crawlers need a different comparison.",
  auditText: "For Contextter, Screaming Frog or Sitebulb, useful measures include discovered URLs, redirect and canonical handling, repeatable runs, raw-data access, limits and cost. We will name no winner until several runs use the same unchanged fixture website.",
  fixtureLink: "View our test fixtures",
  relatedHeading: "Which questions and sources appear in AI answers?",
  relatedText: "AI Fanout runs real OpenAI and Gemini queries. It complements the technical crawler check but does not promise visibility.",
  aiLabel: "Open AI Fanout",
  disclosure: "AnalyseSpider and AI Fanout are operated by Matthias Ramahi. This is a related tool, not an independent recommendation.",
};

const rows = de ? [
  ["Googlebot", "Baut den Google-Suchindex auf.", "Beachtet robots.txt.", "Veröffentlichte IP-Bereiche oder Reverse- und Forward-DNS.", "https://developers.google.com/crawling/docs/crawlers-fetchers/verify-google-requests"],
  ["Bingbot", "Baut den Bing-Suchindex auf.", "Eigener User-Agent-Token.", "Bings Verify-Bingbot-Werkzeug oder DNS-Prüfung.", "https://blogs.bing.com/webmaster/october-2018/bingbot-Series-Maximizing-Crawl-Efficiency"],
  ["OAI-SearchBot", "Erfasst Seiten für ChatGPT-Suche.", "Getrennt von GPTBot steuerbar.", "User-Agent und von OpenAI veröffentlichte IP-Bereiche.", "https://developers.openai.com/api/docs/bots"],
  ["GPTBot", "Kann Inhalte für Modelltraining erfassen.", "Eigener Token, unabhängig von OAI-SearchBot.", "User-Agent und veröffentlichte IP-Bereiche.", "https://developers.openai.com/api/docs/bots"],
  ["ChatGPT-User", "Ruft eine Seite im Auftrag eines Nutzers ab.", "Nicht zur Steuerung der Suchaufnahme gedacht.", "User-Agent und veröffentlichte IP-Bereiche.", "https://developers.openai.com/api/docs/bots"],
  ["Claude-SearchBot", "Erfasst Inhalte für Claudes Sucherlebnisse.", "Anthropic sagt, dass der Bot robots.txt beachtet.", "Token und von Anthropic verlinkte IP-Bereiche.", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler"],
  ["ClaudeBot", "Erfasst Inhalte für mögliches Modelltraining.", "Getrennt von Claude-SearchBot steuerbar.", "Token und verlinkte IP-Bereiche.", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler"],
  ["Google-Extended", "Steuert bestimmte Gemini-Nutzungen; kein eigener HTTP-Crawler.", "Produkt-Token, beeinflusst Google Search nicht.", "Nicht als eigener Request zu verifizieren.", "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers"],
] : [
  ["Googlebot", "Builds the Google Search index.", "Obeys robots.txt.", "Published IP ranges or reverse and forward DNS.", "https://developers.google.com/crawling/docs/crawlers-fetchers/verify-google-requests"],
  ["Bingbot", "Builds the Bing search index.", "Dedicated user-agent token.", "Bing's Verify Bingbot tool or DNS checks.", "https://blogs.bing.com/webmaster/october-2018/bingbot-Series-Maximizing-Crawl-Efficiency"],
  ["OAI-SearchBot", "Collects pages for ChatGPT search.", "Controlled separately from GPTBot.", "User agent and IP ranges published by OpenAI.", "https://developers.openai.com/api/docs/bots"],
  ["GPTBot", "May collect content for model training.", "Its own token, independent of OAI-SearchBot.", "User agent and published IP ranges.", "https://developers.openai.com/api/docs/bots"],
  ["ChatGPT-User", "Fetches a page for a user request.", "Not intended to control search inclusion.", "User agent and published IP ranges.", "https://developers.openai.com/api/docs/bots"],
  ["Claude-SearchBot", "Collects content for Claude search experiences.", "Anthropic says it honors robots.txt.", "Token and IP ranges linked by Anthropic.", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler"],
  ["ClaudeBot", "Collects content for possible model training.", "Controlled separately from Claude-SearchBot.", "Token and linked IP ranges.", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler"],
  ["Google-Extended", "Controls certain Gemini uses; not a separate HTTP crawler.", "Product token; does not affect Google Search.", "Cannot be verified as a separate request.", "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers"],
];
---
<BaseLayout title={copy.title} description={copy.description} canonicalPath={copy.canonical} alternatePath={copy.alternate} lang={locale} bodyClass="simple-content crawler-page">
  <header class="simple-page-lead"><span class="section-kicker">{de ? "Crawler-Studie" : "Crawler study"}</span><h1>{copy.headline}</h1><p>{copy.intro}</p></header>
  <section class="crawler-stage-strip" aria-label={de ? "Drei Stufen" : "Three stages"}>{copy.explain.map(([title, text]) => (<div><strong>{title}</strong><span>{text}</span></div>))}</section>
  <section class="crawler-table-section" aria-labelledby="crawler-table-heading">
    <header><h2 id="crawler-table-heading">{copy.tableHeading}</h2><p>{copy.tableIntro}</p><small>{copy.checked}</small></header>
    <div class="table-wrap crawler-table-wrap"><table class="crawler-table"><thead><tr>{copy.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{rows.map((row) => (<tr><th scope="row"><strong>{row[0]}</strong><a href={row[4]} rel="noreferrer">{copy.source}</a></th><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>))}</tbody></table></div>
  </section>
  <section class="crawler-eligibility"><div><h2>{copy.eligibleHeading}</h2><p><strong>{copy.eligibleNote}</strong></p><a class="text-link" href={de ? "/de/wissen/in-ai-suche-erscheinen" : "/guides/appear-in-ai-search"}>{copy.guide} <ArrowIcon /></a></div><ol>{copy.eligibleSteps.map((step) => <li>{step}</li>)}</ol></section>
  <section class="audit-comparison-note"><h2>{copy.auditHeading}</h2><div><p>{copy.auditText}</p><a href="/lab/crawler-benchmarks">{copy.fixtureLink} <ArrowIcon /></a></div></section>
  <section class="related-work related-fanout"><div><h2>{copy.relatedHeading}</h2><p>{copy.relatedText}</p></div><div class="related-actions"><a class="button secondary" href={de ? "https://ai-fanout.com/de" : "https://ai-fanout.com/"}>{copy.aiLabel}</a></div><p class="disclosure">{copy.disclosure}</p></section>
</BaseLayout>
