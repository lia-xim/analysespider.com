---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageLead from "./PageLead.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { formatDate, type ContentPage } from "../data/content";

interface Props {
  page: ContentPage;
}

const { page } = Astro.props;
const roots = {
  guide: { path: "/guides", label: "Guides", index: "31" },
  "lab-note": { path: "/blog", label: "Articles", index: "41" },
  reference: { path: "/reference", label: "Reference", index: "51" },
  audience: { path: "/for", label: "For teams", index: "61" },
} as const;
const root = roots[page.kind];
const canonicalPath = `${root.path}/${page.slug}`;
const article = page.kind !== "audience";
const takeawayLabel = page.kind === "lab-note" ? "Observed in this case" : page.kind === "reference" ? "Definition" : page.kind === "audience" ? "Use this when" : "In short";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: root.label, path: root.path },
  { name: page.title, path: canonicalPath },
];
---
<BaseLayout
  title={`${page.title} — AnalyseSpider`}
  description={page.description}
  canonicalPath={canonicalPath}
  pageType={article ? "article" : "website"}
  publishedTime={article ? page.publishedAt : undefined}
  modifiedTime={article ? page.updatedAt : undefined}
  breadcrumbs={breadcrumbs}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href={root.path}>{root.label}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{page.title}</span>
  </nav>
  <PageLead title={page.title} intro={page.intro} index={root.index} />

  <div class="article-meta" aria-label="Publication details">
    <span>{page.eyebrow}</span>
    <span>{article ? `Published ${formatDate(page.publishedAt)}` : "For this audience"}</span>
    <span>Updated {formatDate(page.updatedAt)}</span>
    <span>{page.readingMinutes} min read</span>
    {article && <a href="/about#editor">Written and technically reviewed by Matthias Ramahi</a>}
  </div>

  <div class:list={["article-shell", page.kind === "lab-note" && "article-shell-full"]}>
    <article class="article-prose">
      <div class="takeaway">
        <span>{takeawayLabel}</span>
        <p>{page.takeaway}</p>
      </div>

      {page.sections.map((section, sectionIndex) => (
        <section aria-labelledby={`section-${sectionIndex}`}>
          <h2 id={`section-${sectionIndex}`}>{section.heading}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {section.steps && (
            <ol class="numbered-steps">
              {section.steps.map((item) => <li>{item}</li>)}
            </ol>
          )}
          {section.code && <pre class="article-code"><code>{section.code}</code></pre>}
          {section.evidence && (
            <dl class="evidence-grid">
              {section.evidence.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
            </dl>
          )}
          {section.callout && <p class="article-callout">{section.callout}</p>}
        </section>
      ))}
    </article>

    {page.kind !== "lab-note" && <aside class="article-aside" aria-label="Article context">
      <div>
        <span class="aside-label">Scope</span>
        <p>{page.description}</p>
      </div>
      <div>
        <span class="aside-label">Evidence state</span>
        <p>Technical claims are tied to the primary documentation listed below. Current tool behavior is verified against the browser-local implementation.</p>
      </div>
    </aside>}
  </div>

  {page.sources.length > 0 && (
    <section class="source-section" aria-labelledby="sources-heading">
      <header>
        <h2 id="sources-heading">Primary sources</h2>
        <p>Checked for this edition on {formatDate(page.sourceCheckedAt ?? page.updatedAt)}. External documentation can change.</p>
      </header>
      <ol class="source-list">
        {page.sources.map((source, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <a href={source.href} rel="noreferrer">{source.label} <ArrowIcon external /></a>
              <p>{source.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="related-section" aria-labelledby="related-heading">
    <header>
      <h2 id="related-heading">What to do next</h2>
    </header>
    <div class="related-grid">
      {page.related.map((item) => (
        <a href={item.href}>
          <h3>{item.label}</h3>
          <p>{item.note}</p>
          <span class="text-link">Open <ArrowIcon /></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
