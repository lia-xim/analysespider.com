---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "./ArrowIcon.astro";
import type { Locale } from "../data/i18n";

interface Props { locale: Locale; }
interface GuideSection { heading: string; paragraphs: string[]; bullets?: string[]; }

const { locale } = Astro.props;
const de = locale === "de";
const copy = de ? {
  title: "In AI-Suchen erscheinen: Crawling, Indexierung und Quellen — AnalyseSpider",
  description: "Was eine Seite technisch braucht, damit Such- und AI-Crawler sie abrufen können — klar erklärt und ohne Aufnahmeversprechen.",
  canonical: "/de/wissen/in-ai-suche-erscheinen", alternate: "/guides/appear-in-ai-search",
  headline: "Wie kann eine Seite in AI-Suchen erscheinen?",
  intro: "Eine Garantie gibt es nicht. Du kannst aber prüfen, ob eine Seite überhaupt erreichbar ist, ob die richtigen Crawler zugreifen dürfen und ob der Inhalt als Quelle etwas Eigenes beiträgt.",
  short: "Abrufen, indexieren und in einer Antwort zitiert werden sind drei verschiedene Dinge. Nur der erste Schritt lässt sich direkt testen. Alles danach hängt vom jeweiligen Such- oder AI-System ab.",
  sections: [
    { heading: "Zuerst die drei Schritte auseinanderhalten", paragraphs: [
      "Wenn ein Bot deine Seite abruft, weißt du zunächst nur: Dieser eine Request hat eine Serverantwort erhalten. Daraus folgt noch nicht, dass die URL gespeichert, indexiert oder später als Quelle ausgewählt wird.",
      "Auch die Bot-Namen haben unterschiedliche Aufgaben. OpenAI nutzt OAI-SearchBot für die ChatGPT-Suche und GPTBot für mögliches Modelltraining. ChatGPT-User ruft eine Seite im Auftrag eines Nutzers ab. Google verwendet für AI Overviews und AI Mode die normalen Voraussetzungen der Google-Suche; Google-Extended ist dagegen ein Steuertoken für bestimmte Gemini-Nutzungen und kein eigener HTTP-Crawler.",
    ]},
    { heading: "Kommt ein Crawler überhaupt an die Seite?", paragraphs: [
      "Teste die kanonische HTTPS-URL. Sie sollte stabil antworten, normalerweise mit Status 200. Danach prüfst du robots.txt, Meta-Robots und X-Robots-Tag einzeln. Eine Freigabe in robots.txt hilft nicht, wenn CDN, Firewall oder Bot-Schutz den Request trotzdem abweisen.",
      "Wichtige Antworten und interne Links gehören außerdem in das ausgelieferte HTML. Eine Seite kann im Browser gut aussehen und einem Crawler trotzdem fast nur ein leeres JavaScript-Gerüst liefern.",
    ]},
    { heading: "Nicht jeder Bot braucht dieselbe Erlaubnis", paragraphs: [
      "Wer in der ChatGPT-Suche auffindbar sein möchte, darf OAI-SearchBot nicht blockieren. Ob GPTBot Inhalte für Training abrufen darf, ist eine getrennte Entscheidung. Anthropic trennt ebenfalls Suche, Training und nutzergetriggerte Abrufe. Für Google Search bleibt Googlebot entscheidend.",
      "Ein User-Agent ist allerdings nur eine Behauptung. Bei wichtigen Entscheidungen solltest du die IP-Bereiche oder die vom Betreiber beschriebene Reverse- und Forward-DNS-Prüfung verwenden.",
    ]},
    { heading: "Eine erreichbare Seite ist noch keine gute Quelle", paragraphs: [
      "Der Inhalt braucht eine klare Aufgabe. Beantworte die eigentliche Frage früh, erkläre ungewohnte Begriffe und belege veränderliche Fakten mit Primärquellen. Eigene Messungen, nachvollziehbare Beispiele, Screenshots oder Testdaten sind oft wertvoller als eine weitere allgemeine Zusammenfassung.",
    ], bullets: [
      "Eine URL, ein klarer Nutzerjob und eine passende H1",
      "Interne Links aus thematisch passenden Seiten — nicht nur ein Eintrag in der Sitemap",
      "Keine Serien nahezu gleicher Seiten für minimale Keyword-Varianten",
    ]},
    { heading: "Die Logs beenden das Rätselraten", paragraphs: [
      "Der URL-Check zeigt, was bei einem kontrollierten Abruf passiert. Ob ein bestimmter Crawler deine Seite tatsächlich besucht hat, siehst du erst in Server-, CDN- oder Firewall-Logs. Suche dort nach dem veröffentlichten Bot-Token, prüfe bei Bedarf die Identität und vergleiche Pfad, Statuscode und Zeitpunkt.",
      "Webmaster-Tools ergänzen dieses Bild. Search Console kann den Google-Indexierungsstatus zeigen; Bing stellt eigene Webmaster Tools bereit. Für OpenAI oder Anthropic gibt es durch robots.txt oder eine Sitemap keine Aufnahmegarantie.",
    ]},
    { heading: "Was du dir sparen kannst", paragraphs: [
      "Eine llms.txt-Datei, spezielles AI-Markup oder hunderte automatisch erzeugte Frageseiten ersetzen weder Crawlbarkeit noch einen hilfreichen Hauptinhalt. Google verlangt für seine AI-Suchfunktionen kein besonderes AI-Schema. Strukturierte Daten sind nur sinnvoll, wenn sie zum sichtbaren Inhalt und zu einer unterstützten Suchfunktion passen.",
      "Auch ein einzelner Treffer in einer Testabfrage ist kein stabiler Sichtbarkeitswert. Wenn du AI-Antworten beobachtest, notiere Anbieter, Prompt, Datum, Region und gefundene Quellen. Dann bleibt das Ergebnis eine brauchbare Stichprobe statt einer scheinbar exakten Kennzahl.",
    ]},
    { heading: "Eine URL in fünf Minuten prüfen", paragraphs: ["Für einen ersten technischen Check reichen diese Fragen:"], bullets: [
      "Liefert die kanonische HTTPS-URL eine brauchbare Antwort?",
      "Sind Überschrift, Kernantwort und wichtige Links im ersten HTML vorhanden?",
      "Erlauben robots.txt und Seiten-Direktiven den gewünschten Crawler?",
      "Gibt es passende interne Links und steht die URL in der Sitemap?",
      "Zeigen Logs später echte Requests — und nicht nur einen erlaubten Bot-Namen?",
    ]},
  ] as GuideSection[],
  sources: "Primärquellen", checked: "Geprüft am 28. August 2026. Betreiber-Dokumentation kann sich ändern.",
  nextTitle: "Du möchtest eine konkrete Seite prüfen?", nextText: "Gib einfach die Domain oder URL ein. AnalyseSpider ergänzt fehlendes https:// und zeigt die technische Antwort.", next: "URL jetzt prüfen",
  compareTitle: "Du willst die Bots unterscheiden?", compareText: "Die Crawler-Übersicht erklärt, welcher Bot sucht, trainiert oder auf Nutzerwunsch abruft.", compare: "Crawler-Aufgaben vergleichen",
  fanoutTitle: "Technisch erreichbar — aber welche Fragen stellen Menschen an AI-Systeme?",
  fanoutText: "AI Fanout untersucht, wie sich ein Thema in konkrete Such- und Antwortfragen auffächert. Das ist der nächste sinnvolle Schritt, wenn die technische Grundlage stimmt und du Inhalte planst.",
  fanoutAction: "Fragen mit AI Fanout untersuchen",
  disclosure: "AnalyseSpider und AI Fanout werden von Matthias Ramahi betrieben. Das ist ein verwandtes Werkzeug und keine unabhängige Empfehlung.",
} : {
  title: "Appear in AI search: crawling, indexing and sources — AnalyseSpider",
  description: "What a page needs so search and AI crawlers can fetch it, explained plainly and without promises of inclusion.",
  canonical: "/guides/appear-in-ai-search", alternate: "/de/wissen/in-ai-suche-erscheinen",
  headline: "How can a page appear in AI search?",
  intro: "There is no guarantee. You can still check whether a page is reachable, whether the right crawlers may access it and whether the content adds something worth using as a source.",
  short: "Fetching, indexing and being cited in an answer are three different events. Only the first can be tested directly. Everything after that depends on the search or AI system.",
  sections: [
    { heading: "Start by separating the three events", paragraphs: [
      "When a bot fetches your page, you initially know only this: one request received a server response. It does not prove that the URL was stored, indexed or later selected as a source.",
      "Bot names also represent different jobs. OpenAI uses OAI-SearchBot for ChatGPT search and GPTBot for possible model training. ChatGPT-User fetches a page on a user's behalf. Google applies its normal Search eligibility rules to AI Overviews and AI Mode; Google-Extended is a control token for certain Gemini uses, not a separate HTTP crawler.",
    ]},
    { heading: "Can a crawler reach the page at all?", paragraphs: [
      "Test the canonical HTTPS URL. It should respond consistently, normally with status 200. Then inspect robots.txt, meta robots and X-Robots-Tag separately. A robots.txt allowance is not enough when a CDN, firewall or bot defence still rejects the request.",
      "Important answers and internal links should also be present in the delivered HTML. A page can look complete in a browser while exposing little more than an empty JavaScript shell to a crawler.",
    ]},
    { heading: "Different bots need different decisions", paragraphs: [
      "For ChatGPT search eligibility, OAI-SearchBot must not be blocked. Whether GPTBot may fetch content for training is a separate choice. Anthropic also separates search, training and user-triggered retrieval. Googlebot remains the relevant crawler for Google Search.",
      "A user-agent is only a claim, though. For consequential decisions, use published IP ranges or the reverse and forward DNS procedure described by the operator.",
    ]},
    { heading: "A reachable page is not automatically a useful source", paragraphs: [
      "Give the page one clear job. Answer the real question early, define unfamiliar terms and support changing facts with primary sources. Original measurements, reproducible examples, screenshots or test data are often more useful than another broad summary.",
    ], bullets: [
      "One URL, one primary user job and a matching H1",
      "Internal links from relevant pages — not merely a sitemap entry",
      "No series of near-identical pages for tiny keyword variations",
    ]},
    { heading: "Logs replace guesswork with evidence", paragraphs: [
      "A URL check shows what happens during one controlled fetch. To learn whether a particular crawler actually visited, inspect server, CDN or firewall logs. Look for its published token, verify the identity when it matters, and compare the path, status code and timestamp.",
      "Webmaster tools add another layer. Search Console can show Google's indexing state; Bing provides its own Webmaster Tools. A robots.txt allowance or sitemap does not guarantee inclusion by OpenAI or Anthropic.",
    ]},
    { heading: "Shortcuts that do not solve the problem", paragraphs: [
      "An llms.txt file, special AI markup or hundreds of generated question pages do not replace crawl access and useful main content. Google does not require special AI schema for its AI search features. Structured data is useful only when it matches visible content and a supported search feature.",
      "One mention in a test query is not a stable visibility score either. When observing AI answers, record the provider, prompt, date, region and cited sources. That leaves you with a useful sample instead of a misleadingly precise metric.",
    ]},
    { heading: "Check one URL in five minutes", paragraphs: ["These questions are enough for a first technical pass:"], bullets: [
      "Does the canonical HTTPS URL return a useful response?",
      "Are the heading, core answer and important links present in the initial HTML?",
      "Do robots.txt and page directives allow the intended crawler?",
      "Do relevant internal links and the sitemap expose this URL?",
      "Do logs later show real requests rather than only an allowed bot name?",
    ]},
  ] as GuideSection[],
  sources: "Primary sources", checked: "Checked 28 August 2026. Operator documentation can change.",
  nextTitle: "Want to inspect a real page?", nextText: "Enter a domain or URL. AnalyseSpider adds a missing https:// and shows the technical response.", next: "Check a URL now",
  compareTitle: "Need to tell the bots apart?", compareText: "The crawler overview explains which bot searches, trains or fetches on a user's behalf.", compare: "Compare crawler roles",
  fanoutTitle: "Technically reachable — but what questions do people ask AI systems?",
  fanoutText: "AI Fanout explores how a topic branches into specific search and answer questions. It is a useful next step once the technical foundation works and you are planning content.",
  fanoutAction: "Explore questions with AI Fanout",
  disclosure: "AnalyseSpider and AI Fanout are operated by Matthias Ramahi. This is a related tool, not an independent recommendation.",
};

const sources = [
  ["OpenAI: Bots overview", "https://developers.openai.com/api/docs/bots", "OAI-SearchBot, GPTBot, ChatGPT-User and published IP ranges."],
  ["OpenAI: Publishers and developers FAQ", "https://help.openai.com/en/articles/12627856-publishers-and-developers-faq", "Search eligibility and crawler controls; no inclusion guarantee."],
  ["Google: AI features and your website", "https://developers.google.com/search/docs/appearance/ai-features", "Normal Google Search eligibility for AI Overviews and AI Mode."],
  ["Google: AI optimization guide", "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide", "Technical foundations, original value and internal discovery."],
  ["Google: Common crawlers", "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers", "Googlebot and the Google-Extended product token."],
  ["Anthropic: Web crawler controls", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler", "ClaudeBot, Claude-User and Claude-SearchBot."],
];
---
<BaseLayout title={copy.title} description={copy.description} canonicalPath={copy.canonical} alternatePath={copy.alternate} lang={locale} pageType="article" publishedTime="2026-08-28" modifiedTime="2026-08-28" bodyClass="simple-content">
  <header class="simple-page-lead"><span class="section-kicker">{de ? "Leitfaden" : "Guide"}</span><h1>{copy.headline}</h1><p>{copy.intro}</p></header>
  <div class="article-shell ai-search-guide"><article class="article-prose">
    <div class="takeaway"><span>{de ? "Kurz gesagt" : "In short"}</span><p>{copy.short}</p></div>
    {copy.sections.map((section) => (<section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul class="guide-checklist">{section.bullets.map((item) => <li>{item}</li>)}</ul>}</section>))}
    <nav class="guide-next-actions" aria-label={de ? "Nächste sinnvolle Schritte" : "Useful next steps"}>
      <a href={de ? "/de/tools/crawler-sicht" : "/tools/crawler-view"}><strong>{copy.nextTitle}</strong><span>{copy.nextText}</span><em>{copy.next} <ArrowIcon /></em></a>
      <a href={de ? "/de/crawler" : "/crawlers"}><strong>{copy.compareTitle}</strong><span>{copy.compareText}</span><em>{copy.compare} <ArrowIcon /></em></a>
    </nav>
  </article></div>
  <section class="guide-related-fanout" aria-labelledby="fanout-heading"><div><h2 id="fanout-heading">{copy.fanoutTitle}</h2><p>{copy.fanoutText}</p><a href={de ? "https://ai-fanout.com/de" : "https://ai-fanout.com"}>{copy.fanoutAction} <ArrowIcon external /></a><small>{copy.disclosure}</small></div></section>
  <section class="source-section" aria-labelledby="ai-sources"><header><h2 id="ai-sources">{copy.sources}</h2><p>{copy.checked}</p></header><ol class="source-list">{sources.map(([label, href, note], index) => (<li><span>{String(index + 1).padStart(2, "0")}</span><div><a href={href} rel="noreferrer">{label} <ArrowIcon external /></a><p>{note}</p></div></li>))}</ol></section>
</BaseLayout>
