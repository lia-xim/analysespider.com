---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowIcon from "./ArrowIcon.astro";
import type { Locale } from "../data/i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === "de";
const copy = de ? {
  title: "In AI-Suchen erscheinen: Crawling, Indexierung und Quellen — AnalyseSpider",
  description: "Verstehe, wie Seiten für ChatGPT-Suche, Google AI Overviews und Claude technisch auffindbar werden — ohne Aufnahme- oder Ranking-Versprechen.",
  canonical: "/de/wissen/in-ai-suche-erscheinen", alternate: "/guides/appear-in-ai-search",
  headline: "Wie kann eine Seite in AI-Suchen erscheinen?",
  intro: "Es gibt keinen Schalter, der eine URL sicher in eine AI-Antwort bringt. Du kannst aber dafür sorgen, dass die richtigen Crawler zugreifen dürfen, die Seite technisch verständlich ist und ihr Inhalt eine klare Frage besser beantwortet als austauschbare Zusammenfassungen.",
  short: "Trenne zuerst drei Dinge: Ein Crawler darf die Seite abrufen, ein System kann sie für seine Suche oder seinen Index verarbeiten, und eine konkrete Antwort kann sie später als Quelle auswählen. Der erste Schritt ist prüfbar. Die beiden anderen sind nie garantiert.",
  sections: [
    ["1. Crawler, Index und Antwort sind drei verschiedene Stufen", ["Ein erfolgreicher Bot-Aufruf beweist nur, dass eine bestimmte Anfrage deine Serverantwort erhalten hat. Er beweist nicht, dass die URL dauerhaft gespeichert, indexiert oder in einer Antwort zitiert wurde.", "OpenAI trennt OAI-SearchBot für ChatGPT-Suche von GPTBot für mögliches Modelltraining. ChatGPT-User ist wiederum ein nutzergetriggerter Abruf und kein Beleg für automatische Suchaufnahme. Google nutzt für AI Overviews und AI Mode die normalen Voraussetzungen der Google-Suche. Google-Extended ist ein robots.txt-Steuertoken für bestimmte Gemini-Nutzungen, aber kein eigener HTTP-Crawler und beeinflusst die Aufnahme in Google Search nicht." ]],
    ["2. Mache die URL technisch erreichbar", ["Die Seite braucht eine stabile öffentliche URL und sollte für den vorgesehenen Crawler eine brauchbare 200-Antwort liefern. Prüfe außerdem robots.txt, Meta-Robots und X-Robots-Tag. Ein CDN oder eine Web Application Firewall kann einen erlaubten Bot trotzdem blockieren; deshalb zählen die tatsächliche Serverantwort und die Logs.", "JavaScript kann eine Seite für Menschen gut aussehen lassen, während im ersten HTML kaum Inhalt steht. Suche und AI-Systeme können JavaScript unterschiedlich verarbeiten. Eine klare Überschrift, die Kernantwort und wichtige interne Links sollten deshalb bereits im Server-HTML vorhanden sein." ]],
    ["3. Erlaube den richtigen Bot — nicht pauschal jeden", ["Wenn du in ChatGPT-Suche erscheinen möchtest, darf OAI-SearchBot nicht blockiert sein. Ob GPTBot für Training zugreifen darf, ist eine getrennte Entscheidung. Für Claude veröffentlicht Anthropic getrennte Tokens für Suche, Training und nutzergetriggerte Abrufe. Bei Google bleibt Googlebot für die Suchaufnahme entscheidend.", "Eine robots.txt-Freigabe ist keine Identitätsprüfung. User-Agent-Namen lassen sich kopieren. Wenn eine Entscheidung wichtig ist, gleiche die IP mit den veröffentlichten Bereichen ab oder nutze die vom Betreiber beschriebene Reverse- und Forward-DNS-Prüfung." ]],
    ["4. Gib dem System eine eindeutige, belegbare Antwort", ["Technische Freigabe allein macht einen Inhalt nicht nützlich. Eine gute Seite beantwortet eine erkennbare Frage früh, erklärt Begriffe, zeigt überprüfbare Schritte und nennt Primärquellen dort, wo sich Fakten ändern können. Eigene Messungen, Beispiele, Screenshots oder Test-Fixtures schaffen einen Grund, gerade diese Seite zu verwenden.", "Vermeide viele Seiten, die dieselbe Absicht nur mit anderen Formulierungen wiederholen. Das macht die Auswahl schwieriger und verteilt interne Signale. Eine starke URL mit klarer Aufgabe, verständlichem Titel, passender H1 und natürlichen internen Links ist leichter einzuordnen." ]],
    ["5. Verbinde Auffindbarkeit mit einer sauberen Website-Struktur", ["Verlinke wichtige Inhalte aus thematisch passenden Hubs und von verwandten Artikeln. Eine aktuelle XML-Sitemap hilft bei der Entdeckung, ersetzt aber keine internen Links. Canonicals sollten auf die tatsächlich bevorzugte, indexierbare 200-URL zeigen. Fehlerseiten, Suchergebnisse und Utility-Pfade gehören nicht in die Sitemap.", "Für Google kannst du Search Console verwenden; für Bing stehen Bing Webmaster Tools und Sitemaps zur Verfügung. OpenAI und Anthropic versprechen durch eine Freigabe oder Sitemap keine Aufnahme. Miss deshalb beobachtbare Dinge: Bot-Anfragen in Logs, Indexierungsstatus in Webmaster-Tools, echte Referrals und Seiten, die Nutzer anschließend aufrufen." ]],
    ["6. Prüfe die Serverantwort und danach die echten Anfragen", ["Beginne mit einer einzelnen URL. Der AnalyseSpider-Check zeigt, ob sie abrufbar ist, welche robots.txt-Regeln gefunden wurden, ob Seiten-Direktiven die Indexierung erlauben und ob im ersten HTML sinnvoller Hauptinhalt erkennbar ist. Das ist ein reproduzierbarer Ausgangspunkt, aber noch keine Aussage darüber, welcher Bot die Seite später wirklich besucht.", "Der zweite Beleg liegt in deinen Server- oder CDN-Logs. Filtere nach den veröffentlichten Bot-Tokens, behandle den User-Agent zunächst als Behauptung und prüfe wichtige Identitäten mit der Methode des Betreibers. Vergleiche anschließend Pfade, Statuscodes und Zeiträume. So siehst du beobachtetes Verhalten, statt aus einer robots.txt-Datei einen Besuch abzuleiten." ]],
    ["7. Vermeide Abkürzungen, die keine sind", ["Spezielle AI-Markups, eine llms.txt-Datei oder massenhaft erzeugte Frage-Seiten ersetzen weder Crawlbarkeit noch einen hilfreichen Hauptinhalt. Google sagt ausdrücklich, dass für seine AI-Suchfunktionen keine besondere AI-Datei und kein spezielles Schema nötig sind. Strukturierte Daten helfen nur, wenn sie zum sichtbaren Inhalt passen und die jeweilige Suchfunktion sie unterstützt.", "Auch eine Erwähnung in einer einzelnen Testabfrage ist kein stabiler Visibility-Score. Antworten variieren nach Anfrage, Zeitpunkt, Modell und Kontext. Wenn du AI-Antworten beobachtest, dokumentiere Prompt, Anbieter, Datum, Region und gefundene Quellen. Behandle das als Stichprobe und nicht als Rankingbericht." ]],
    ["8. Prüfliste für eine einzelne URL", ["1. Liefert die kanonische HTTPS-URL eine stabile 200-Antwort? 2. Ist sie im ersten HTML verständlich? 3. Erlauben robots.txt und Seiten-Direktiven den gewünschten Suchcrawler? 4. Blockiert die Infrastruktur den Bot trotzdem? 5. Gibt es interne Links und eine saubere Sitemap? 6. Beantwortet die Seite eine konkrete Frage mit eigener, überprüfbarer Substanz? 7. Werden Logs, Webmaster-Daten und Referrals gemessen?", "Wenn diese Punkte erfüllt sind, ist die URL technisch besser vorbereitet. Das ist eine Eignungsaussage, kein Versprechen für Indexierung, Ranking oder Zitation." ]],
  ],
  sources: "Primärquellen", checked: "Geprüft am 28. August 2026. Betreiber-Dokumentation kann sich ändern.",
  next: "URL jetzt prüfen", compare: "Crawler und ihre Aufgaben vergleichen",
} : {
  title: "Appear in AI search: crawling, indexing and sources — AnalyseSpider",
  description: "Understand how pages become technically eligible for ChatGPT search, Google AI Overviews and Claude without promises of inclusion or ranking.",
  canonical: "/guides/appear-in-ai-search", alternate: "/de/wissen/in-ai-suche-erscheinen",
  headline: "How can a page appear in AI search?",
  intro: "There is no switch that guarantees a URL a place in an AI answer. You can, however, let the right crawlers in, make the page technically understandable and publish an answer that is more useful than a generic summary.",
  short: "Separate three events: a crawler can fetch the page, a system may process it for search or an index, and a later answer may select it as a source. The first event is testable. The other two are never guaranteed.",
  sections: [
    ["1. Crawler, index and answer are separate stages", ["A successful bot request proves only that one request received your server response. It does not prove that the URL was stored, indexed or cited in an answer.", "OpenAI separates OAI-SearchBot for ChatGPT search from GPTBot for possible model training. ChatGPT-User is a user-triggered fetch and not evidence of automatic search inclusion. Google applies its normal Search eligibility requirements to AI Overviews and AI Mode. Google-Extended is a robots.txt control token for certain Gemini uses, not a separate HTTP crawler, and it does not control inclusion in Google Search." ]],
    ["2. Make the URL technically reachable", ["The page needs a stable public URL and should return a useful 200 response to the intended crawler. Check robots.txt, meta robots and X-Robots-Tag as separate controls. A CDN or web application firewall can still block an allowed bot, so the observed response and server logs matter.", "JavaScript can produce a good human interface while leaving very little content in the initial HTML. Search and AI systems process JavaScript differently. Put the clear heading, core answer and important internal links in server-rendered HTML." ]],
    ["3. Allow the right bot, not every bot", ["For eligibility in ChatGPT search, OAI-SearchBot must not be blocked. Whether GPTBot may access content for training is a separate choice. Anthropic publishes different tokens for search, training and user-triggered retrieval. Googlebot remains the relevant crawler for Google Search inclusion.", "A robots.txt allowance does not prove identity. User-agent names can be copied. For a consequential decision, compare the IP with published ranges or perform the reverse and forward DNS checks described by the operator." ]],
    ["4. Give the system a clear, supportable answer", ["Technical access alone does not make content useful. A strong page answers a recognisable question early, defines terms, provides reproducible steps and cites primary sources for changing facts. Original measurements, examples, screenshots or test fixtures provide a reason to use this page rather than another summary.", "Avoid publishing many pages that repeat one intent with slightly different wording. That makes selection harder and splits internal signals. One strong URL with a clear job, descriptive title, matching H1 and natural internal links is easier to understand." ]],
    ["5. Connect discoverability to a clean site structure", ["Link important pages from relevant hubs and related articles. A current XML sitemap helps discovery but does not replace internal links. Canonicals should point to the preferred, indexable 200 URL. Error pages, site-search results and utility paths do not belong in the sitemap.", "Use Search Console for Google and Bing Webmaster Tools for Bing. Neither OpenAI nor Anthropic promises inclusion after a robots allowance or sitemap submission. Measure observable events instead: bot requests in logs, indexing states in webmaster tools, real referrals and the next pages those visitors use." ]],
    ["6. Inspect the response, then observe real requests", ["Start with one URL. The AnalyseSpider check shows whether it is fetchable, which robots.txt rules were found, whether page directives allow indexing and whether the initial HTML contains detectable main content. That is a reproducible starting point, not a statement about which bot will visit later.", "The second source of evidence is your server or CDN log. Filter for published bot tokens, treat the user agent as a claim first and verify consequential identities with the operator's method. Then compare paths, status codes and time windows. This shows observed behaviour instead of inferring a visit from a robots.txt file." ]],
    ["7. Avoid shortcuts that do not solve the problem", ["Special AI markup, an llms.txt file or hundreds of generated question pages do not replace crawl access and useful main content. Google explicitly says its AI search features need no special AI file or schema. Structured data helps only when it matches visible content and a supported search feature.", "A mention in one test query is not a stable visibility score either. Answers vary by query, time, model and context. When observing AI answers, record the prompt, provider, date, region and cited sources. Treat the result as a sample, not a ranking report." ]],
    ["8. A checklist for one URL", ["1. Does the canonical HTTPS URL return a stable 200? 2. Is the initial HTML understandable? 3. Do robots.txt and page directives allow the intended search crawler? 4. Does the infrastructure block it anyway? 5. Do internal links and the sitemap expose the page? 6. Does it answer a specific question with original, verifiable substance? 7. Are logs, webmaster data and referrals measured?", "Passing these checks makes the URL better prepared technically. It is an eligibility statement, not a promise of indexing, ranking or citation." ]],
  ],
  sources: "Primary sources", checked: "Checked 28 August 2026. Operator documentation can change.",
  next: "Check a URL now", compare: "Compare crawler roles",
};

const sources = [
  ["OpenAI: Bots overview", "https://developers.openai.com/api/docs/bots", "OAI-SearchBot, GPTBot, ChatGPT-User and published IP ranges."],
  ["OpenAI: Publishers and developers FAQ", "https://help.openai.com/en/articles/12627856-publishers-and-developers-faq", "Search eligibility and crawler controls; no inclusion guarantee."],
  ["Google: AI features and your website", "https://developers.google.com/search/docs/appearance/ai-features", "Normal Google Search eligibility for AI Overviews and AI Mode."],
  ["Google: AI optimization guide", "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide", "Technical foundations, original value and internal discovery."],
  ["Google: Common crawlers", "https://developers.google.com/crawling/docs/crawlers-fetchers/google-common-crawlers", "Googlebot and the Google-Extended product token."],
  ["Anthropic: Web crawler controls", "https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler", "ClaudeBot, Claude-User and Claude-SearchBot."],
];
const sections = copy.sections as Array<[string, string[]]>;
---
<BaseLayout title={copy.title} description={copy.description} canonicalPath={copy.canonical} alternatePath={copy.alternate} lang={locale} pageType="article" publishedTime="2026-08-28" modifiedTime="2026-08-28" bodyClass="simple-content">
  <header class="simple-page-lead"><span class="section-kicker">{de ? "Leitfaden" : "Guide"}</span><h1>{copy.headline}</h1><p>{copy.intro}</p></header>
  <div class="article-shell ai-search-guide">
    <article class="article-prose">
      <div class="takeaway"><span>{de ? "Kurz gesagt" : "In short"}</span><p>{copy.short}</p></div>
      {sections.map(([heading, paragraphs]) => (<section><h2>{heading}</h2>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>))}
    </article>
    <aside class="article-aside" aria-label={de ? "Nächste Schritte" : "Next steps"}>
      <div><span class="aside-label">Tool</span><a href={de ? "/de/tools/crawler-sicht" : "/tools/crawler-view"}>{copy.next} <ArrowIcon /></a></div>
      <div><span class="aside-label">Crawler</span><a href={de ? "/de/crawler" : "/crawlers"}>{copy.compare} <ArrowIcon /></a></div>
    </aside>
  </div>
  <section class="source-section" aria-labelledby="ai-sources"><header><h2 id="ai-sources">{copy.sources}</h2><p>{copy.checked}</p></header><ol class="source-list">{sources.map(([label, href, note], index) => (<li><span>{String(index + 1).padStart(2, "0")}</span><div><a href={href} rel="noreferrer">{label} <ArrowIcon external /></a><p>{note}</p></div></li>))}</ol></section>
</BaseLayout>
