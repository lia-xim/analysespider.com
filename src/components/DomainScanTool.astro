---
import type { Locale } from "../data/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const de = locale === "de";
const copy = de
  ? {
      title: "Website-Indexierung prüfen",
      intro:
        "Gib deine Domain ein. AnalyseSpider prüft bis zu 50 gefundene URLs auf Statuscode, robots.txt, noindex und Canonical. Eine öffentliche Google-site:-Suche liefert danach einen Hinweis, aber keinen Indexbeweis.",
      label: "Öffentliche Website",
      placeholder: "example.com",
      submit: "Website prüfen",
      note: "Maximal 50 URLs · 2 Scans je 10 Minuten · 10 Scans je 24 Stunden · Cache höchstens 1 Stunde",
      warning:
        "Keine privaten, signierten oder geheimen URLs eingeben. Vollständige URLs können im zeitlich begrenzten Gateway-Cache stehen.",
      progress:
        "Sitemap wird gesucht und bis zu 50 öffentliche URLs werden geprüft …",
      error: "Der Website-Check konnte nicht abgeschlossen werden.",
      checked: "Geprüft",
      fetchable: "Abrufbar",
      indexable: "Ohne technischen Index-Blocker",
      problems: "Mit Problemen",
      all: "Alle URLs",
      issues: "Nur Probleme",
      source: "Gefunden über",
      sitemap: "Sitemap",
      links: "Links auf der Startseite",
      homepage: "Nur Startseite",
      url: "URL",
      http: "HTTP",
      robots: "Googlebot erlaubt?",
      indexing: "Indexierung erlaubt?",
      canonical: "Canonical",
      google: "Google-Spot-Check",
      finding: "Hinweis",
      download: "JSON herunterladen",
      googleSite: "Domain auf Google prüfen",
      googleUrl: "URL auf Google prüfen",
      googleSeen: "Google-Treffer gesehen",
      googleUnchecked: "Google-Checks offen",
      columnHelpTitle: "Was bedeuten diese Spalten?",
      httpHelp: "HTTP zeigt, ob der Server eine erfolgreiche Antwort wie 200 oder einen Fehler bzw. Redirect liefert.",
      robotsHelp: "Googlebot erlaubt bedeutet nur, dass die beobachtete robots.txt den Google-Suchcrawler für diese URL nicht sperrt.",
      indexingHelp: "Indexierung erlaubt bedeutet nur, dass in der gelieferten Antwort kein noindex gefunden wurde. Es beweist keine Aufnahme in Google.",
      canonicalHelp: "Canonical zeigt, welche URL die Seite selbst als bevorzugte Version nennt. Google kann trotzdem eine andere Version wählen.",
      googleHelp: "Der Link öffnet eine öffentliche site:-Suche für genau diese URL. Kehre danach zurück und halte fest, ob du einen Treffer gesehen hast. Ein fehlender Treffer bleibt unklare Evidenz.",
      evidenceScale: "Evidenz: technischer Abruf = aktueller Live-Befund · Google-Treffer = öffentlicher Hinweis · kein Google-Treffer = unklar · Search Console = verifizierter Property-Status.",
      googlePrivacy: "Google erhält die geprüfte URL erst, wenn du einen Google-Spot-Check anklickst.",
      boundaryTitle: "Das ist ein technischer Website-Check, kein Google-Indexbericht.",
      boundary:
        "Ein grünes Ergebnis bedeutet: Die beobachtete Serverantwort enthält keinen offensichtlichen technischen Blocker. Ob Google die URL tatsächlich indexiert hat, lässt sich zuverlässig nur über deine Search-Console-Property prüfen.",
      contextter: "Echten Google-Status in Crawl Foundry prüfen",
      disclosure:
        "Crawl Foundry und AnalyseSpider werden von Matthias Ramahi betrieben. Das ist eine weiterführende Funktion desselben Betreibers, keine unabhängige Empfehlung.",
      guide: "Warum eine technisch erreichbare Seite trotzdem fehlen kann",
    }
  : {
      title: "Check up to 50 URLs on your website.",
      intro:
        "Enter only the domain. AnalyseSpider technically checks up to 50 discovered URLs. You can then spot-check each URL with a public Google site: search.",
      label: "Public website",
      placeholder: "example.com",
      submit: "Check website",
      note: "Maximum 50 URLs · 2 scans per 10 minutes · 10 scans per 24 hours · cached for no more than 1 hour",
      warning:
        "Do not enter private, signed, or secret-bearing URLs. Complete URLs can appear in the time-limited gateway cache.",
      progress: "Finding the sitemap and checking up to 50 public URLs …",
      error: "The website check could not be completed.",
      checked: "Checked",
      fetchable: "Fetchable",
      indexable: "No technical index blocker",
      problems: "With problems",
      all: "All URLs",
      issues: "Problems only",
      source: "Discovered from",
      sitemap: "Sitemap",
      links: "Homepage links",
      homepage: "Homepage only",
      url: "URL",
      http: "HTTP",
      robots: "Googlebot allowed?",
      indexing: "Indexing allowed?",
      canonical: "Canonical",
      google: "Google spot-check",
      finding: "Finding",
      download: "Download JSON",
      googleSite: "Check domain on Google",
      googleUrl: "Check URL on Google",
      googleSeen: "Google results seen",
      googleUnchecked: "Google checks open",
      columnHelpTitle: "What do these columns mean?",
      httpHelp: "HTTP shows whether the server returned a successful response such as 200, an error, or a redirect.",
      robotsHelp: "Googlebot allowed only means the observed robots.txt does not block Google's search crawler from this URL.",
      indexingHelp: "Indexing allowed only means no noindex directive was found in the delivered response. It does not prove inclusion in Google.",
      canonicalHelp: "Canonical shows which URL the page itself names as its preferred version. Google can still choose another version.",
      googleHelp: "The link opens a public site: search for this exact URL. Return afterwards and record whether you saw a result. An absent result remains inconclusive evidence.",
      evidenceScale: "Evidence: technical fetch = current live observation · Google result = public clue · no Google result = unknown · Search Console = verified property status.",
      googlePrivacy: "Google receives the checked URL only after you click a Google spot-check.",
      boundaryTitle: "This is a technical website check, not a Google index report.",
      boundary:
        "A green result means the observed server response contains no obvious technical blocker. Only your Search Console property can reliably show whether Google has actually indexed the URL.",
      contextter: "Check the real Google status in Crawl Foundry",
      disclosure:
        "Crawl Foundry and AnalyseSpider are operated by Matthias Ramahi. This is a deeper feature from the same operator, not an independent recommendation.",
      guide: "How HTTP responses affect crawl and indexing checks",
    };
---

<section class="domain-scan" data-domain-scan data-locale={locale}>
  <header class="domain-scan-intro">
    <p class="eyebrow">{de ? "Website Index Check" : "Website index check"}</p>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
  </header>

  <form class="crawler-check-form" data-domain-scan-form novalidate>
    <label class="visually-hidden" for={`domain-scan-url-${locale}`}>{copy.label}</label>
    <div class="crawler-input-row">
      <input
        id={`domain-scan-url-${locale}`}
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        required
        maxlength="2048"
        placeholder={copy.placeholder}
        aria-describedby={`domain-scan-note-${locale} domain-scan-warning-${locale}`}
      />
      <button type="submit">{copy.submit}</button>
    </div>
    <p id={`domain-scan-note-${locale}`} class="crawler-form-note">{copy.note}</p>
    <p id={`domain-scan-warning-${locale}`} class="crawler-form-note crawler-sensitive-url-note">{copy.warning}</p>
  </form>

  <p class="crawler-progress" data-domain-scan-progress role="status" aria-live="polite" hidden>
    <span aria-hidden="true"></span>{copy.progress}
  </p>

  <section class="crawler-error" data-domain-scan-error role="alert" hidden>
    <h2>{copy.error}</h2>
    <p data-domain-scan-error-text></p>
  </section>

  <div class="domain-scan-results" data-domain-scan-results hidden>
    <div class="domain-scan-result-header">
      <p data-domain-scan-meta></p>
      <div class="domain-scan-actions">
        <select data-domain-scan-filter aria-label={de ? "URLs filtern" : "Filter URLs"}>
          <option value="all">{copy.all}</option>
          <option value="issues">{copy.issues}</option>
        </select>
        <a href="https://www.google.com/" target="_blank" rel="noreferrer" data-domain-google-site-check>{copy.googleSite}</a>
        <button type="button" data-domain-scan-download>{copy.download}</button>
      </div>
    </div>

    <div class="domain-scan-summary" aria-live="polite">
      <article><span>{copy.checked}</span><strong data-summary="checked">0</strong></article>
      <article><span>{copy.fetchable}</span><strong data-summary="fetchable">0</strong></article>
      <article><span>{copy.indexable}</span><strong data-summary="indexable">0</strong></article>
      <article><span>{copy.problems}</span><strong data-summary="problems">0</strong></article>
      <article><span>{copy.googleSeen}</span><strong data-summary="google-seen">0</strong></article>
      <article><span>{copy.googleUnchecked}</span><strong data-summary="google-unchecked">0</strong></article>
    </div>

    <details class="domain-scan-help">
      <summary>{copy.columnHelpTitle}</summary>
      <dl>
        <div><dt>{copy.http}</dt><dd>{copy.httpHelp}</dd></div>
        <div><dt>{copy.robots}</dt><dd>{copy.robotsHelp}</dd></div>
        <div><dt>{copy.indexing}</dt><dd>{copy.indexingHelp}</dd></div>
        <div><dt>{copy.canonical}</dt><dd>{copy.canonicalHelp}</dd></div>
        <div><dt>{copy.google}</dt><dd>{copy.googleHelp}</dd></div>
      </dl>
      <p><strong>{copy.evidenceScale}</strong></p>
      <p>{copy.googlePrivacy}</p>
    </details>

    <div class="domain-scan-table-wrap">
      <table class="domain-scan-table">
        <thead>
          <tr>
            <th scope="col">{copy.url}</th>
            <th scope="col"><abbr title={copy.httpHelp}>{copy.http}</abbr></th>
            <th scope="col"><abbr title={copy.robotsHelp}>{copy.robots}</abbr></th>
            <th scope="col"><abbr title={copy.indexingHelp}>{copy.indexing}</abbr></th>
            <th scope="col"><abbr title={copy.canonicalHelp}>{copy.canonical}</abbr></th>
            <th scope="col"><abbr title={copy.googleHelp}>{copy.google}</abbr></th>
            <th scope="col">{copy.finding}</th>
          </tr>
        </thead>
        <tbody data-domain-scan-rows></tbody>
      </table>
    </div>
    <p class="domain-scan-empty" data-domain-scan-empty hidden></p>

    <section class="crawler-index-boundary">
      <div>
        <p class="eyebrow">{de ? "Grenze des Checks" : "Check boundary"}</p>
        <h2>{copy.boundaryTitle}</h2>
        <p>{copy.boundary}</p>
      </div>
      <div class="crawler-index-actions">
        <a class="button primary" href={de ? "https://crawlfoundry.com/de/features/site-audit?utm_source=analysespider.com&utm_medium=referral&utm_campaign=domain_scan" : "https://crawlfoundry.com/features/site-audit?utm_source=analysespider.com&utm_medium=referral&utm_campaign=domain_scan"}>
          {copy.contextter}
        </a>
      </div>
      <p class="crawler-policy-note">{copy.disclosure}</p>
      <p class="crawler-policy-note">
        <a href={de ? "/de/wissen/warum-wird-meine-seite-nicht-indexiert" : "/guides/http-response-debugging"}>{copy.guide}</a>
      </p>
    </section>
  </div>
</section>

<script>
  import { mountDomainScanTools } from "../lib/domain-scan";
  mountDomainScanTools();
</script>
