---
import ArrowIcon from "./ArrowIcon.astro";
import type { Locale } from "../data/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const de = locale === "de";
const copy = de
  ? {
      title: "Technische SEO-Tools",
      intro: "Prüfe eine URL, eine robots.txt-Regel oder einen Server-Log. Wähle einfach das passende Werkzeug.",
      liveTitle: "Crawler-Analyse-Tool",
      liveText:
        "Sieh, ob eine öffentliche Seite erreichbar ist, welche Crawler-Regeln gelten und was im ersten HTML steht.",
      liveAction: "Crawler-Analyse starten",
      localHeading: "Weitere Tools",
      openTool: "Tool öffnen",
      guidanceHeading: "Das richtige Werkzeug wählen",
      guidance: [
        "Beginne mit dem URL-Check, wenn du Status, Canonical, robots.txt und initiales HTML einer öffentlichen Seite gemeinsam sehen möchtest.",
        "Nutze die spezialisierten Tools, wenn du bereits weißt, welche Evidenz fehlt: eine Redirect-Kette, eine konkrete robots.txt-Regel, Logzeilen, eine IP-Zuordnung oder die Verifikation einer Bot-Anfrage.",
        "Behandle jedes Ergebnis als Beobachtung mit Grenzen. Ein erfolgreicher Abruf beweist weder Indexierung noch Ranking oder einen Besuch des behaupteten Crawlers.",
      ],
      boundaryHeading: "Datengrenze",
      boundaryText: "Lokale Werkzeuge verarbeiten eingefügte Daten im Browser. Öffentliche URL-Prüfungen laufen begrenzt über den geschützten Gateway; Eingaben, Limits und Aussagegrenzen stehen jeweils direkt am Tool.",
      tools: [
        {
          title: "Website-Indexierbarkeit prüfen",
          href: "/de/tools/google-index-check",
        },
        {
          title: "Crawler-Log-Analyse",
          href: "/de/tools/server-log-analyse",
        },
        {
          title: "HTTP-Antwort prüfen",
          href: "/de/tools/http-antwort",
        },
        {
          title: "Redirect-Kette prüfen",
          href: "/de/tools/weiterleitungskette",
        },
        {
          title: "robots.txt-Tester",
          href: "/de/tools/robots-regel-test",
        },
        {
          title: "robots.txt Generator",
          href: "/de/tools/robots-txt-generator",
        },
        {
          title: "IP-Adressen-Check",
          href: "/de/tools/ip-adresse",
        },
        {
          title: "Bot-Anfrage verifizieren",
          href: "/de/tools/bot-verifizierung",
        },
      ],
    }
  : {
      title: "Technical SEO tools",
      intro: "Check a URL, a robots.txt rule or a server log. Choose the tool that matches the job.",
      liveTitle: "Crawler Analysis Tool",
      liveText:
        "See whether a public page responds, which crawler rules apply and what appears in its initial HTML.",
      liveAction: "Start crawler analysis",
      localHeading: "More tools",
      openTool: "Open tool",
      guidanceHeading: "Choose the right diagnostic",
      guidance: [
        "Start with the URL check when you need status, canonical, robots.txt and initial HTML evidence for one public page in the same report.",
        "Use a focused tool when the missing evidence is already clear: a redirect chain, one robots.txt rule, a bounded log sample, an IP allocation or verification of a claimed bot request.",
        "Treat every result as a bounded observation. A successful fetch does not prove indexing, ranking or a visit from the crawler named in a user-agent string.",
      ],
      boundaryHeading: "Data boundary",
      boundaryText: "Local tools keep pasted data in the browser. Public URL checks use the protected gateway with explicit input and usage limits; each tool states what its result can and cannot establish.",
      tools: [
        {
          title: "Website Indexability Check",
          href: "/tools/google-index-check",
        },
        {
          title: "Crawler Log Analyzer",
          href: "/tools/log-file-inspector",
        },
        {
          title: "HTTP Response Checker",
          href: "/tools/url-inspector",
        },
        {
          title: "Redirect Chain Checker",
          href: "/tools/redirect-chain",
        },
        {
          title: "Robots.txt Tester",
          href: "/tools/robots-rule-tester",
        },
        {
          title: "Robots.txt Generator",
          href: "/tools/robots-txt-generator",
        },
        {
          title: "IP Address Checker",
          href: "/tools/ip-location",
        },
        {
          title: "Bot Request Verifier",
          href: "/tools/bot-verification",
        },
      ],
    };
---

<header class="simple-page-lead tool-hub-lead">
  <h1>{copy.title}</h1>
  <p>{copy.intro}</p>
</header>

<section class="tool-hub-live" aria-labelledby="live-tool-heading">
  <div>
    <h2 id="live-tool-heading">{copy.liveTitle}</h2>
    <p>{copy.liveText}</p>
  </div>
  <a class="button primary" href={de ? "/de/tools/crawler-sicht" : "/tools/crawler-view"}>{copy.liveAction}</a>
</section>

<section class="content-grid tool-hub-guidance" aria-labelledby="tool-guidance-heading">
  <div class="prose">
    <h2 id="tool-guidance-heading">{copy.guidanceHeading}</h2>
    {copy.guidance.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <aside class="side-note">
    <h3>{copy.boundaryHeading}</h3>
    <p>{copy.boundaryText}</p>
  </aside>
</section>

<section class="tool-hub-local" aria-labelledby="local-tools-heading">
  <h2 id="local-tools-heading">{copy.localHeading}</h2>
  <div class="tool-directory">
    {copy.tools.map((tool) => (
      <a class="tool-directory-item" href={tool.href}>
        <h3>{tool.title}</h3>
        <span>{copy.openTool} <ArrowIcon /></span>
      </a>
    ))}
  </div>
</section>
